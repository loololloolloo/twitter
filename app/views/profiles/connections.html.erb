<div class="layout">
  <section class="col-main">
    <nav class="stream-head">
      <a class="head-back" href="<%= profile_path(@user.username) %>" title="Back to profile">&#8592;</a>
      <div class="stream-head-title">
        <h1><%= @user.display_name %></h1>
        <span class="stream-head-sub"><%= count_label(@user.follower_count) %> followers</span>
      </div>
    </nav>

    <%# The same strip as the profile and notifications screens: the 2019
        control weights the active cell bold with a blue underline through
        `.pt-item`, and `.profile-tabs` only lays the bar out. The Following and
        Followers pages are a view of the profile, so they carry the profile's
        tab control rather than the older card-backed `.page-tabs` bar, which
        read as a different widget on the one account surface still using it. %>
    <ul class="profile-tabs">
      <li class="pt-item">
        <a href="<%= profile_path(@user.username) %>">Tweets</a>
      </li>
      <li class="pt-item <%= 'is-active' if @active == 'following' %>">
        <% if @active == 'following' %><span>Following</span>
        <% else %><a href="<%= following_path(@user.username) %>">Following</a><% end %>
      </li>
      <li class="pt-item <%= 'is-active' if @active == 'followers' %>">
        <% if @active == 'followers' %><span>Followers</span>
        <% else %><a href="<%= followers_path(@user.username) %>">Followers</a><% end %>
      </li>
    </ul>

    <% if @active == "followers" && @bonus_followers.to_i.positive? %>
      <div class="section-card">
        <p class="settings-note">
          Showing <%= @people.size %> of <%= count_label(@user.follower_count) %> followers.
          <% if @bonus_followers.to_i.positive? %>
            <%= @bonus_followers %> were granted by an administrator.
          <% end %>
        </p>
      </div>
    <% end %>

    <ul class="row-list">
      <% if @people.present? %>
        <% @people.each do |person| %>
          <li class="row-item">
            <a class="row-avatar" href="<%= profile_path(person.username) %>"><%= pic(person.avatar_path, 48) %></a>
            <div class="row-body">
              <div class="row-title">
                <a class="row-name" href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
                <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
                <span class="row-handle">@<%= person.username %></span>
              </div>
              <% if person.bio.present? %><p class="row-note"><%= person.bio %></p><% end %>
            </div>
            <% if person.id != current_user.id %>
              <div class="row-action">
                <% if current_user.following.exists?(id: person.id) %>
                  <%= form_with url: follow_user_path(person.username), method: :delete, class: "inline" do %>
                    <button class="btn btn-following btn-pill" type="submit">Following</button>
                  <% end %>
                <% else %>
                  <%= form_with url: follow_user_path(person.username), method: :post, class: "inline" do %>
                    <button class="btn btn-follow btn-pill" type="submit">Follow</button>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      <% else %>
        <%# 2019 centred a glyph over a heading and a sub-line here rather than
            leaving a bare sentence in a list row, matching the other empty
            screens; followers get a different glyph from following. %>
        <li>
          <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true"><%= icon(@active == "following" ? 'users' : 'user') %></span>
            <% if @active == "following" %>
              <h2>@<%= @user.username %> isn&rsquo;t following anyone yet</h2>
              <p>When they follow someone, they&rsquo;ll be listed here.</p>
            <% else %>
              <h2>@<%= @user.username %> doesn&rsquo;t have any followers yet</h2>
              <p>When someone follows them, they&rsquo;ll be listed here.</p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail" %>
  </aside>
</div>

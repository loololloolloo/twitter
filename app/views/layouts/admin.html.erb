<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= content_for?(:title) ? yield(:title) : "Admin / #{@site_name}" %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= stylesheet_link_tag "twitter" %>
<link rel="icon" href="<%= asset_path('icons/twitter-bird.svg') %>">
<%= csrf_meta_tags %>
</head>
<body class="admin-body">

<%# The panel keeps its global bar for cross-cutting destinations, and the rail
    below it carries the section navigation. Both are kept deliberate: the bar is
    where "Back to site" and the panel's own tabs live, the rail is where the
    working areas live. %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= admin_root_path %>" title="Admin / <%= @site_name %>"><%= bird %></a>
    <nav class="topnav">
      <a href="<%= admin_root_path %>" class="<%= 'active' if controller_name == 'dashboard' %>">Dashboard</a>
      <% if can?('users.view') %><a href="<%= admin_users_path %>" class="<%= 'active' if controller_name == 'users' %>">Users</a><% end %>
      <% if can?('reports.view') %>
        <a href="<%= admin_reports_path %>" class="<%= 'active' if controller_name == 'reports' %>">
          Reports<% if defined?(@open_reports_nav) && @open_reports_nav.to_i.positive? %><span class="nav-count"><%= @open_reports_nav %></span><% end %>
        </a>
      <% end %>
      <% if can?('users.permissions') %><a href="<%= admin_permissions_path %>" class="<%= 'active' if controller_name == 'permissions' %>">Roles</a><% end %>
      <% if can?('tweets.view') %><a href="<%= admin_tweets_path %>" class="<%= 'active' if controller_name == 'tweets' %>">Tweets</a><% end %>
      <% if can?('audit.view') %><a href="<%= admin_audit_path %>" class="<%= 'active' if controller_name == 'audit' %>">Audit log</a><% end %>
      <% if can?('admin.access') %><a href="<%= admin_insights_path %>" class="<%= 'active' if controller_name == 'insights' %>">Insights</a><% end %>
      <% if can?('maintenance.run') %><a href="<%= admin_tools_path %>" class="<%= 'active' if controller_name == 'tools' %>">Tools</a><% end %>
      <% if can?('settings.edit') %><a href="<%= admin_settings_path %>" class="<%= 'active' if controller_name == 'settings' %>">Settings</a><% end %>
    </nav>
    <div class="topbar-right">
      <%= link_to "Back to site", home_path, class: "account-link" %>
    </div>
  </div>
</header>

<div class="admin-shell">
  <aside class="admin-rail">
      <%# The rail is not a second copy of the top bar. The section links live up
          there alone; what the rail carries is the operator's own card, a live
          at-a-glance count of the queues they can act on, and a handful of quick
          actions that are shortcuts rather than destinations. %>
      <section class="operator-card">
        <div class="operator-identity">
          <%= pic(current_user.avatar_path, 48) %>
          <div class="operator-names">
            <span class="operator-name"><%= current_user.display_name %></span>
            <span class="operator-handle">@<%= current_user.username %></span>
          </div>
        </div>

        <dl class="operator-facts">
          <div class="operator-fact">
            <dt>Role</dt>
            <dd><span class="pill pill-role"><%= current_user.role.name %></span></dd>
          </div>
          <div class="operator-fact">
            <dt>Account</dt>
            <dd>
              <% if current_user.owner? %><span class="pill pill-ok">owner</span><% end %>
              <span class="muted">since <%= joined(current_user.created_at) %></span>
            </dd>
          </div>
        </dl>

        <a class="btn operator-profile" href="<%= profile_path(current_user.username) %>">View profile</a>
      </section>

      <%# Live counts. Each is gated on the permission that lets the operator do
          something about it, so nobody is shown a queue they cannot open. %>
      <section class="rail-block">
        <h3 class="rail-heading">At a glance</h3>
        <ul class="rail-stats">
          <% if can?('users.view') %>
            <li><a href="<%= admin_users_path %>"><strong><%= count_label(User.count) %></strong> accounts</a></li>
            <li><a href="<%= admin_users_path(status: 'suspended') %>"><strong><%= count_label(User.where(is_suspended: true).count) %></strong> suspended</a></li>
          <% end %>
          <% if can?('reports.view') %>
            <li>
              <a href="<%= admin_reports_path(state: 'open') %>">
                <strong><%= count_label(Report.open.count) %></strong> open reports
              </a>
            </li>
          <% end %>
          <% if can?('tweets.view') %>
            <li><a href="<%= admin_tweets_path %>"><strong><%= count_label(Tweet.count) %></strong> posts</a></li>
          <% end %>
        </ul>
      </section>

      <%# Shortcuts, not destinations. Each jumps straight to the working screen
          for the thing an operator most often needs to do next. %>
      <% if can?('users.view') || can?('reports.view') || can?('maintenance.run') %>
        <section class="rail-block">
          <h3 class="rail-heading">Quick actions</h3>
          <div class="rail-actions-list">
            <% if can?('users.view') %><a href="<%= admin_users_path(status: 'banned') %>">Review banned accounts</a><% end %>
            <% if can?('reports.resolve') %><a href="<%= admin_reports_path(state: 'open') %>">Work the report queue</a><% end %>
            <% if can?('tweets.view') %><a href="<%= admin_tweets_path %>">Moderate recent posts</a><% end %>
            <% if can?('maintenance.run') %><a href="<%= admin_tools_path(tab: 'content') %>">Bulk content cleanups</a><% end %>
            <% if can?('backup.export') %><a href="<%= admin_backup_path %>">Export a backup</a><% end %>
          </div>
        </section>
      <% end %>
  </aside>

  <main class="admin-main">
    <div class="flash-wrap">
      <% flash.each do |key, message| %>
        <div class="flash <%= flash_class(key) %>"><%= message %></div>
      <% end %>
    </div>

    <%= yield %>
  </main>
</div>

<%= javascript_include_tag "jquery.min" %>
<%= javascript_include_tag "twitter" %>
</body>
</html>

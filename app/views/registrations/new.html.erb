<% content_for :title, "Sign up / #{@site_name}" %>

<%# Sign-up gets the same single-column treatment as log-in: bird, heading, and
    one card holding the whole form. The fields carry visible labels now, which
    is the redesign's own treatment. %>
<div class="auth-page">
  <div class="auth-bird"><%= bird %></div>
  <h1 class="auth-title">Join <%= @site_name %> today.</h1>

  <div class="auth-card">
    <% if @signups_closed %>
      <p class="signup-closed">Signups are currently closed on this instance.</p>
    <% else %>
      <%= form_with url: signup_path, method: :post, id: "phx-signup-form",
                    class: "auth-form signup", local: true do %>
        <% if @user&.errors&.any? %>
          <div class="auth-errors">
            <% @user.errors.full_messages.each do |message| %>
              <p class="error" role="alert"><%= message %></p>
            <% end %>
          </div>
        <% end %>

        <div class="auth-field">
          <label for="full-name">Full name</label>
          <input id="full-name" type="text" autocomplete="off" name="display_name"
                 maxlength="20" aria-required="true" placeholder="Full name"
                 value="<%= params[:display_name] %>">
        </div>

        <div class="auth-field">
          <label for="username">Username</label>
          <input id="username" type="text" autocomplete="off" name="username"
                 maxlength="15" aria-required="true" placeholder="Username"
                 value="<%= params[:username] %>">
        </div>

        <div class="auth-field">
          <label for="email">Email</label>
          <input id="email" type="text" autocomplete="off"
                 name="email" aria-required="true" placeholder="Email"
                 value="<%= params[:email] %>">
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" aria-required="true"
                 placeholder="Password" autocomplete="new-password">
        </div>

        <div class="auth-field">
          <label for="password_confirm">Confirm password</label>
          <input id="password_confirm" type="password" name="password_confirm"
                 aria-required="true" placeholder="Confirm password"
                 autocomplete="new-password">
        </div>

        <input class="auth-submit" type="submit" id="submit_button" value="Sign up">
      <% end %>

      <p class="befound">
        By signing up, you agree to the
        <a href="<%= tos_path %>" class="legal-link">Terms of Service</a> and
        <a href="<%= privacy_path %>" class="legal-link">Privacy Policy</a>,
        including Cookie Use. Others will be able to find you by email when provided.
      </p>
    <% end %>
  </div>

  <p class="auth-foot">
    Already have an account?
    <a href="<%= login_path %>">Log in</a>
  </p>
</div>

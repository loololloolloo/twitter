<!DOCTYPE html>
<%# Two independent choices ride on the root element, because neither can be
    resolved after paint without a flash: `data-theme` is the light/dark
    palette and `data-design` is which era of the client the account is on.
    Both are read from the account, so a signed-out visitor gets the current
    design in light. %>
<% design = signed_in? ? current_user.design : User::DEFAULT_DESIGN %>
<html lang="en"
      data-theme="<%= signed_in? && current_user.dark_theme? ? 'dark' : 'light' %>"
      data-design="<%= design %>">
<head>
<meta charset="utf-8">
<title>Clever | Login</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= stylesheet_link_tag "twitter" %>
<%# Each recovered design ships its own sheet over the top of the current one:
    the classic palettes and metrics, applied without restyling the 2019 rules
    that every page still uses. Loading it only for the active design keeps the
    two from fighting. %>
<% if design == "2015" %>
  <%= stylesheet_link_tag "twitter-2015" %>
<% elsif design == "prototype" %>
  <%= stylesheet_link_tag "twitter-prototype" %>
<% end %>
<link rel="icon" type="image/png" sizes="32x32" href="/clever-favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/clever-favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/clever-favicon-180.png">
<%= csrf_meta_tags %>
</head>
<body class="<%= "logged-out" unless signed_in? %> design-<%= design %>">

<% if signed_in? && !current_user.legacy_design? %>
<%# The 2019 redesign moves navigation out of a global top bar and into a left
    sidebar: icon plus label, a primary action button, and the account switcher
    pinned to the bottom. The grid is three columns - the rail, the stream and
    the right rail - so the shell owns the horizontal structure rather than each
    page rebuilding it. %>
<div class="app-shell">
  <%= render "shared/side_nav" %>
  <div class="app-main">
    <div class="page <%= 'page-wide' if controller_name == 'profiles' && action_name == 'show' %>">
<% elsif signed_in? %>
  <%= render "shared/top_bar" %>
  <div class="app-main app-main-legacy">
    <div class="page <%= 'page-wide' if controller_name == 'profiles' && action_name == 'show' %>">
<% else %>
  <div class="app-main app-main-public">
    <div class="page">
<% end %>

<% if @announcement.present? %>
  <div class="announcement-banner">
    <%= icon('bullhorn') %>
    <span><%= @announcement %></span>
  </div>
<% end %>

<div class="flash-wrap">
  <% flash.each do |key, message| %>
    <div class="flash <%= flash_class(key) %>"><%= message %></div>
  <% end %>
</div>

<%= yield %>

<%# Close whichever shell was opened above. The 2019 branch opened three
    elements (shell, main, page); the legacy and signed-out branches opened two,
    and the legacy one adds its footer inside the main column. %>
<% if signed_in? && !current_user.legacy_design? %>
    </div>
  </div>
</div>
<% elsif signed_in? %>
    </div>
  </div>
<footer class="site-footer">
  <a href="<%= about_path %>">About</a>
  <a href="<%= help_path %>">Help</a>
  <a href="<%= tos_path %>">Terms</a>
  <a href="<%= privacy_path %>">Privacy</a>
  <span>&copy; <%= @site_name %></span>
</footer>
<% else %>
    </div>
  </div>
<% end %>

<%# On the 2019 design the rail carries these links and the copyright on
    signed-in pages, so the global footer is only for signed-out screens. The
    recovered designs render their own footer above. %>
<% unless signed_in? %>
<footer class="site-footer">
  <a href="<%= about_path %>">About</a>
  <a href="<%= help_path %>">Help</a>
  <a href="<%= tos_path %>">Terms</a>
  <a href="<%= privacy_path %>">Privacy</a>
  <span>&copy; <%= @site_name %></span>
</footer>
<% end %>

<%# While an operator is browsing as another member, a strip stays pinned to the
    bottom of every page so the session is never mistaken for their own. %>
<% if impersonating? %>
<div class="impersonation-bar">
  <span>You are browsing as @<%= current_user.username %>, impersonating a member.</span>
  <%= button_to "Return to my account", admin_stop_impersonating_path,
                class: "btn btn-mini", form_class: "inline" %>
</div>
<% end %>

<%= javascript_include_tag "jquery.min" %>
<%= javascript_include_tag "twitter" %>
</body>
</html>

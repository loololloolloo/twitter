<% content_for :title, "Discover / #{@site_name}" %>

<div class="layout">
  <aside class="col-left">
    <div class="panel">
      <h3 class="panel-title">Search</h3>
      <form class="side-search" action="<%= explore_path %>" method="get">
        <input type="text" name="q" placeholder="Search Twitter" value="<%= @query %>">
        <button class="btn btn-primary" type="submit">Go</button>
      </form>
    </div>
  </aside>

  <section class="col-main">
    <h2 class="section-title">
      <% if @query.present? %>Results for &ldquo;<%= @query %>&rdquo;<% else %>Popular on <%= @site_name %><% end %>
    </h2>

    <% if @query.present? && @people.present? %>
      <div class="panel">
        <h3 class="panel-title">People</h3>
        <ul class="user-list">
          <% @people.each do |person| %>
            <li class="user-row">
              <a class="user-row-avatar" href="<%= profile_path(person.username) %>"><%= pic(person.avatar_path, 48) %></a>
              <div class="user-row-body">
                <a class="user-row-name" href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
                <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
                <span class="user-row-handle">@<%= person.username %></span>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <ul class="timeline">
      <% if @tweets.present? %>
        <% @tweets.each do |tweet| %>
          <%= render "tweets/tweet", tweet: tweet %>
        <% end %>
      <% else %>
        <li class="empty">Nothing found.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <div class="panel">
      <h3 class="panel-title">About</h3>
      <p class="panel-note">Search across tweets and people.</p>
    </div>
  </aside>
</div>
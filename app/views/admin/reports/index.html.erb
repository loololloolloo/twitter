<div class="page-head">
  <div>
    <h1>Reports</h1>
    <p class="page-note">
      Reported content awaiting a decision. <%= @open_count %> open.
    </p>
  </div>
</div>

<nav class="state-tabs">
  <% Report::STATES.each do |state| %>
    <a class="state-tab <%= 'active' if @state == state %>"
       href="<%= admin_reports_path(state: state, category: @category.presence) %>">
      <%= state.capitalize %>
      <span class="state-count"><%= @counts[state] %></span>
    </a>
  <% end %>
</nav>

<form class="admin-filter" action="<%= admin_reports_path %>" method="get">
  <input type="hidden" name="state" value="<%= @state %>">
  <select name="category">
    <option value="">Any category</option>
    <% Report::CATEGORIES.each do |key, label| %>
      <option value="<%= key %>" <%= 'selected' if @category == key %>><%= label %></option>
    <% end %>
  </select>
  <select name="sort">
    <option value="risk" <%= 'selected' if @sort == 'risk' %>>Highest risk first</option>
    <option value="oldest" <%= 'selected' if @sort == 'oldest' %>>Oldest first</option>
  </select>
  <button class="btn btn-primary" type="submit">Filter</button>
</form>

<p class="page-note">
  Ordered by a computed risk score. Each row names the signals that produced it;
  the score informs the order, it never decides the outcome.
</p>

<%# Saved views sit above the list because they are how an operator arrives at
    it: the same slice of the queue, opened by name instead of by rebuilding the
    filter. Applying one is a read, so it is a plain link; saving and deleting
    change the operator's own shortcuts and are POST/DELETE. %>
<details class="panel saved-views" <%= "open" if @saved_views.present? %>>
  <summary class="panel-title">
    Saved views
    <span class="muted">
      <%= @saved_views.size %> saved<%= " - \"#{@active_view.name}\" is your default" if @active_view %>
    </span>
  </summary>

  <% if @saved_views.present? %>
    <ul class="view-list">
      <% @saved_views.each do |view| %>
        <li class="view-row <%= 'is-default' if view.is_default %>">
          <a class="view-name" href="<%= admin_reports_path(SavedQueueView.filter_params(view)) %>">
            <%= view.name %>
          </a>
          <span class="view-summary"><%= view.summary %></span>
          <% if view.is_default %>
            <span class="pill pill-ok">default</span>
          <% end %>
          <% if can?('reports.views') %>
            <% unless view.is_default %>
              <%= form_with url: admin_queue_view_default_path(view), method: :post,
                            class: "inline" do %>
                <button class="btn btn-mini" type="submit">Make default</button>
              <% end %>
            <% end %>
            <%= form_with url: admin_queue_view_path(view), method: :delete, class: "inline",
                          html: { onsubmit: "return confirm('Delete the saved view \"#{view.name}\"?')" } do %>
              <button class="btn btn-mini btn-danger" type="submit">Delete</button>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No saved views yet.</p>
  <% end %>

  <% if can?('reports.views') %>
    <div class="view-save">
      <h4 class="panel-subtitle">Save the current filter</h4>
      <p class="muted">
        Saving stores this view's filters, not a frozen list of reports: it always
        opens on whatever currently matches, so it cannot go stale.
      </p>
      <%= form_with url: admin_queue_views_path, method: :post, class: "stack" do %>
        <input type="hidden" name="queue" value="reports">
        <input type="hidden" name="state" value="<%= @state %>">
        <input type="hidden" name="category" value="<%= @category %>">
        <input type="hidden" name="sort" value="<%= @sort %>">
        <label>Name
          <input type="text" name="name" maxlength="<%= SavedQueueView::MAX_NAME %>"
                 placeholder="e.g. Open abuse reports" required>
        </label>
        <label class="check">
          <input type="checkbox" name="is_default" value="1">
          Open the queue on this view
        </label>
        <button class="btn btn-primary" type="submit">Save view</button>
      <% end %>
    </div>
  <% else %>
    <p class="muted">You can see saved views but not change them.</p>
  <% end %>
</details>

<% if @reports.present? %>
  <% @reports.each do |report| %>
    <article class="report-item">
      <div class="report-main">
        <div class="report-who">
          <%= pic(report.user.avatar_path, 32) %>
          <span class="report-subject">@<%= report.user.username %></span>
          <span class="tag tag-info"><%= report.category_label %></span>
          <% if report.tweet.nil? %>
            <span class="report-when">account report</span>
          <% end %>
          <span class="report-when"><%= time_ago(report.created_at) %></span>
        </div>

        <% risk = RiskScore.for(report) %>
        <p class="risk-line" title="<%= risk.explanation %>">
          <span class="pill pill-risk-<%= risk.band %>"><%= risk.score %> risk</span>
          <span class="risk-band"><%= risk.band_label %></span>
          <% unless risk.factors.empty? %>
            <span class="risk-factors">
              <% risk.factors.each do |factor| %>
                <span class="risk-factor"><%= factor.label %> <%= factor.detail %> <b>+<%= factor.points %></b></span>
              <% end %>
            </span>
          <% end %>
        </p>

        <p class="report-detail">
          Reported by
          <% if report.reporter %>
            <strong>@<%= report.reporter.username %></strong>
          <% else %>
            <strong>the site</strong>
          <% end %>
          <% if report.tweet %>
            on tweet <code>#<%= report.tweet.id %></code>.
          <% else %>
            on the account itself.
          <% end %>
        </p>

        <% if report.detail.present? %>
          <p class="report-detail"><%= report.detail %></p>
        <% end %>

        <% if report.tweet %>
          <blockquote class="report-quote">
            <%= report.tweet.body.presence || "(media only)" %>
          </blockquote>
          <p class="report-detail">
            <a href="<%= profile_path(report.user.username) %>">View profile</a>
          </p>
        <% end %>
      </div>

      <div class="report-side">
        <% if can?('cases.open') %>
          <%# The queue is where a cluster becomes visible, so this is where a
              case is opened: the report is carried across, not retyped. %>
          <p class="muted">
            <a href="<%= admin_cases_path(user_id: report.user_id, tweet_id: report.tweet_id, report_ids: [ report.id ]) %>">
              Open a case from this report
            </a>
          </p>
        <% end %>
        <% if report.open? %>
          <% if can?('reports.resolve') %>
            <%= form_with url: admin_report_resolve_path(report), method: :post, class: "stack" do %>
              <label>Resolution note
                <input type="text" name="note" placeholder="What did you decide?">
              </label>
              <div class="action-row">
                <button class="btn btn-danger" type="submit" name="decision" value="actioned">
                  Action content
                </button>
                <button class="btn" type="submit" name="decision" value="dismissed">
                  Dismiss report
                </button>
              </div>
            <% end %>
          <% else %>
            <p class="muted">You cannot resolve reports.</p>
          <% end %>
        <% else %>
          <p>
            <span class="pill <%= report.state == 'actioned' ? 'pill-bad' : 'pill-ok' %>">
              <%= report.state %>
            </span>
          </p>
          <p class="muted">
            by <%= report.resolved_by ? "@#{report.resolved_by.username}" : "system" %>
            <%= time_ago(report.resolved_at) %>
          </p>
          <% if report.resolution_note.present? %>
            <p class="report-detail"><%= report.resolution_note %></p>
          <% end %>
        <% end %>
      </div>
    </article>
  <% end %>
<% else %>
  <p class="muted">Nothing in this queue.</p>
<% end %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<%# The browser tab is deliberately generic on every page. It must not give
    away what the site is, so a profile does not read "@user / Profile" and the
    panel does not read "Admin". The favicon is set to match. %>
<title>Clever | Login</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%# The panel ships its own stylesheet rather than the consumer client's, so
    dropping the timeline's look is structural: its rules are not loaded here
    at all and cannot leak into the console. %>
<%= stylesheet_link_tag "admin-ops" %>
<link rel="icon" type="image/png" sizes="32x32" href="/clever-favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/clever-favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/clever-favicon-180.png">
<%= csrf_meta_tags %>
</head>
<body class="admin-body">

<%# The blue workspace bar. The mark identifies the system, the section links
    run across the middle, and the operator sits on the right. %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= admin_root_path %>" aria-label="Operations console">
      <%= bird_mark %>
    </a>

    <%# The toolbar's tabs are the tools an operator reaches for while working,
        not the places they navigate to. The rail owns "where am I"; this row
        owns "what do I do with this". The two lists are kept deliberately
        disjoint so neither is a copy of the other. %>
    <nav class="topnav">
      <% if can?('lookup.run') %>
        <a href="<%= admin_lookup_path %>" class="<%= 'active' if controller_name == 'lookup' %>">Lookup</a>
      <% end %>
      <% if can?('escalations.view') %>
        <a href="<%= admin_escalations_path %>" class="<%= 'active' if controller_name == 'escalations' %>">
          Escalations<% if @escalation_count.to_i.positive? %><span class="nav-count"><%= @escalation_count %></span><% end %>
        </a>
      <% end %>
      <% if can?('sessions.view') %>
        <a href="<%= admin_sessions_path %>" class="<%= 'active' if controller_name == 'sessions' %>">
          Sessions<% if @active_session_count.to_i.positive? %><span class="nav-count"><%= count_label(@active_session_count) %></span><% end %>
        </a>
      <% end %>
      <% if can?('relations.view') %>
        <a href="<%= admin_relations_path %>" class="<%= 'active' if controller_name == 'relations' %>">Relations</a>
      <% end %>
      <% if can?('lists.view') %>
        <a href="<%= admin_lists_path %>" class="<%= 'active' if controller_name == 'lists' %>">Lists</a>
      <% end %>
    </nav>

    <div class="topbar-right">
      <a class="topbar-link" href="<%= home_path %>">Back to site</a>
      <span class="operator-chip">
        <%= pic(current_user.avatar_path, 24) %>
        <span class="operator-chip-name">@<%= current_user.username %></span>
        <span class="role-chip"><%= current_user.role.name %></span>
      </span>
    </div>
  </div>
</header>

<div class="admin-shell">
  <aside class="admin-rail">
    <%# The rail is the working navigation. Its groups lead with the queues an
        operator works through, then the reference surfaces, then the controls.
        Each row carries the live count for its queue where there is one, so the
        rail answers "what needs attention" without opening anything. %>
    <nav class="rail-nav">
      <div class="rail-group">
        <h3 class="rail-group-title">Queues</h3>
        <a href="<%= admin_users_path %>" class="<%= 'is-active' if controller_name == 'users' %>">
          <%= icon('users') %><span class="rail-label">Accounts</span>
          <span class="rail-group-count"><%= count_label(User.count) %></span>
        </a>
        <% if can?('users.view') %>
          <a href="<%= admin_users_path(status: 'suspended') %>">
            <%= icon('ban') %><span class="rail-label">Suspended</span>
            <span class="rail-group-count"><%= count_label(User.where(is_suspended: true).count) %></span>
          </a>
          <a href="<%= admin_users_path(status: 'banned') %>">
            <%= icon('lock') %><span class="rail-label">Banned</span>
            <span class="rail-group-count"><%= count_label(User.where(is_banned: true).count) %></span>
          </a>
        <% end %>
        <% if can?('reports.view') %>
          <a href="<%= admin_reports_path(state: 'open') %>" class="<%= 'is-active' if controller_name == 'reports' %>">
            <%= icon('flag') %><span class="rail-label">Reports</span>
            <span class="rail-group-count"><%= count_label(Report.open.count) %></span>
          </a>
        <% end %>
        <% if can?('cases.view') %>
          <a href="<%= admin_cases_path(state: 'open') %>" class="<%= 'is-active' if controller_name == 'cases' %>">
            <%= icon('link') %><span class="rail-label">Cases</span>
            <span class="rail-group-count"><%= count_label(ModerationCase.open.count) %></span>
          </a>
        <% end %>
        <% if can?('tweets.view') %>
          <a href="<%= admin_tweets_path %>" class="<%= 'is-active' if controller_name == 'tweets' %>">
            <%= icon('comment') %><span class="rail-label">Posts</span>
            <span class="rail-group-count"><%= count_label(Tweet.count) %></span>
          </a>
        <% end %>
        <% if can?('appeals.view') %>
          <a href="<%= admin_appeals_path(state: 'pending') %>" class="<%= 'is-active' if controller_name == 'appeals' %>">
            <%= icon('shield-halved') %><span class="rail-label">Appeals</span>
            <span class="rail-group-count"><%= count_label(Appeal.pending.count) %></span>
          </a>
        <% end %>
        <% if can?('verification.view') %>
          <a href="<%= admin_verification_path(state: 'pending') %>" class="<%= 'is-active' if controller_name == 'verification' %>">
            <%= icon('verified') %><span class="rail-label">Verification</span>
            <span class="rail-group-count"><%= count_label(VerificationRequest.pending.count) %></span>
          </a>
        <% end %>
        <% if can?('approvals.decide') %>
          <a href="<%= admin_approvals_path(state: 'pending') %>" class="<%= 'is-active' if controller_name == 'approvals' %>">
            <%= icon('users') %><span class="rail-label">Approvals</span>
            <span class="rail-group-count"><%= count_label(ApprovalRequest.pending.count) %></span>
          </a>
        <% end %>
      </div>

      <div class="rail-group">
        <h3 class="rail-group-title">Reference</h3>
        <% if can?('audit.view') %>
          <a href="<%= admin_audit_path %>" class="<%= 'is-active' if controller_name == 'audit' %>">
            <%= icon('clock') %><span class="rail-label">Audit log</span>
          </a>
        <% end %>
        <% if can?('admin.access') %>
          <a href="<%= admin_insights_path %>" class="<%= 'is-active' if controller_name == 'insights' %>">
            <%= icon('chart-simple') %><span class="rail-label">Insights</span>
          </a>
        <% end %>
        <% if can?('users.permissions') %>
          <a href="<%= admin_permissions_path %>" class="<%= 'is-active' if controller_name == 'permissions' %>">
            <%= icon('sliders') %><span class="rail-label">Roles</span>
          </a>
        <% end %>
      </div>

      <div class="rail-group">
        <h3 class="rail-group-title">Controls</h3>
        <% if can?('maintenance.run') %>
          <a href="<%= admin_tools_path %>" class="<%= 'is-active' if controller_name == 'tools' %>">
            <%= icon('wrench') %><span class="rail-label">Tools</span>
          </a>
        <% end %>
        <% if can?('settings.edit') %>
          <a href="<%= admin_settings_path %>" class="<%= 'is-active' if controller_name == 'settings' %>">
            <%= icon('gear') %><span class="rail-label">Settings</span>
          </a>
        <% end %>
        <% if can?('settings.view') %>
          <a href="<%= admin_blocked_terms_path %>" class="<%= 'is-active' if controller_name == 'blocked_terms' %>">
            <%= icon('eye-slash') %><span class="rail-label">Blocked terms</span>
            <span class="rail-group-count"><%= count_label(BlockedTerm.active.count) %></span>
          </a>
        <% end %>
        <% if can?('backup.export') %>
          <a href="<%= admin_backup_path %>">
            <%= icon('bookmark-solid') %><span class="rail-label">Export backup</span>
          </a>
        <% end %>
      </div>
    </nav>

    <%# The operator, pinned to the foot of the rail: who this session is
        acting as, and how to get back to the public site. %>
    <div class="rail-operator">
      <%= pic(current_user.avatar_path, 40) %>
      <div class="rail-operator-names">
        <span class="rail-operator-name"><%= current_user.display_name %></span>
        <span class="rail-operator-handle">@<%= current_user.username %></span>
      </div>
      <span class="rail-operator-role pill pill-role"><%= current_user.role.name %></span>
    </div>
  </aside>

  <main class="admin-main">
    <div class="flash-wrap">
      <% flash.each do |key, message| %>
        <div class="flash <%= flash_class(key) %>"><%= message %></div>
      <% end %>
    </div>

    <%= yield %>
  </main>
</div>

<%= javascript_include_tag "jquery.min" %>
<%= javascript_include_tag "twitter" %>
</body>
</html>

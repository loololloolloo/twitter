<div class="layout">
  <section class="col-main">
    <div class="stream-head">
      <div class="stream-head-title">
        <h1><% if @mode == "search" %>Results for &ldquo;<%= @query %>&rdquo;<% else %>Explore<% end %></h1>
        <% if @mode == "landing" && @section %>
          <span class="stream-head-sub"><%= @section["sub"] %></span>
        <% end %>
      </div>
    </div>

    <%# The Explore landing screen and a search share this action but not their
        tabs. Landing shows the 2019 sections (For you, Trending, News, Sports,
        Entertainment); a search shows the result tabs (Top, Latest, People,
        Photos, Videos). Only one strip is ever rendered, so a reader never sees
        a tab that belongs to the other screen. %>
    <% if @mode == "landing" %>
      <ul class="profile-tabs">
        <% { "for-you" => "For you", "trending" => "Trending", "news" => "News",
             "sports" => "Sports", "entertainment" => "Entertainment" }.each do |key, label| %>
          <li class="pt-item <%= 'is-active' if @tab == key %>">
            <% if @tab == key %>
              <span><%= label %></span>
            <% else %>
              <a href="<%= explore_path(tab: key) %>"><%= label %></a>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% elsif @query.present? %>
      <ul class="profile-tabs">
        <% { "top" => "Top", "latest" => "Latest", "people" => "People",
             "photos" => "Photos", "videos" => "Videos" }.each do |key, label| %>
          <li class="pt-item <%= 'is-active' if @tab == key %>">
            <% if @tab == key %>
              <span><%= label %></span>
            <% else %>
              <a href="<%= explore_path(q: @query, tab: key) %>"><%= label %></a>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @mode == "landing" %>
      <%# A section leads with the trends it can offer, which is what 2019 did:
          the landing sections were ways into the trend list rather than bare
          timelines. For you and Trending show the whole list; a vertical shows
          only the trends whose tag belongs to it. %>
      <% section_trends = @tab == "for-you" || @tab == "trending" ? @trends : (@section ? @trends.select { |tag, _, _| @section["terms"].any? { |w| tag.include?(w) } } : []) %>
      <% if section_trends.present? %>
        <div class="section-card">
          <h2><%= @tab == "trending" || @tab == "for-you" ? "Trends for you" : @section["heading"] %></h2>
          <ul class="row-list">
            <% section_trends.first(5).each do |tag, count, authors, category| %>
              <li class="row-item">
                <div class="row-body">
                  <div class="row-title">
                    <% if category.present? %>
                      <span class="trend-category">Trending in <%= category %></span>
                    <% end %>
                    <a class="row-name" href="<%= explore_path(q: "##{tag}") %>">#<%= tag %></a>
                  </div>
                  <span class="row-handle">
                    <%= count %> <%= 'Tweet'.pluralize(count) %>
                    &middot; <%= authors %> <%= 'account'.pluralize(authors) %>
                  </span>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <% if @query.present? && @people.present? && %w[top people].include?(@tab) %>
      <div class="section-card">
        <h2>People</h2>
        <ul class="row-list">
          <% @people.each do |person| %>
            <li class="row-item">
              <a class="row-avatar" href="<%= profile_path(person.username) %>"><%= pic(person.avatar_path, 48) %></a>
              <div class="row-body">
                <div class="row-title">
                  <a class="row-name" href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
                  <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
                  <span class="row-handle">@<%= person.username %></span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <ul class="timeline">
      <% if @tweets.present? %>
        <% @tweets.each do |tweet| %>
          <%= render "tweets/tweet", tweet: tweet %>
        <% end %>
      <% else %>
        <li class="empty-note">Nothing found.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail", trends_title: "Trending" %>
  </aside>
</div>
<%# Composer box. Used on the home timeline and on tweet permalinks for replies.
    The 2019 composer: the author's picture, a borderless prompt, and a bar with
    the media button, the character counter and a pill Tweet button.
    `quote_of` attaches another post beneath whatever is written here. %>
<% parent_id = local_assigns[:parent_id] %>
<% quote_of = local_assigns[:quote_of] %>
<% placeholder = local_assigns[:placeholder] || @site_tagline %>

<div class="compose timeline-tweet-box" id="reply">
  <%= pic(current_user&.avatar_path, 48) %>
  <%= form_with url: compose_path, method: :post, class: "compose-form tweet-form",
                html: { multipart: true } do %>
    <% if parent_id %>
      <input type="hidden" name="parent_id" value="<%= parent_id %>">
    <% end %>
    <% if quote_of %>
      <input type="hidden" name="quote_of_id" value="<%= quote_of.id %>">
    <% end %>
    <div class="tweet-content">
      <textarea class="tweet-box" name="body" maxlength="<%= @max_len %>"
                placeholder="<%= placeholder %>" data-counter></textarea>

      <%# A quote shows the post being attached, so the writer can see what they
          are quoting while they write. %>
      <% if quote_of %>
        <div class="compose-quote">
          <div class="quote-head">
            <%= pic(quote_of.user.avatar_path, 20) %>
            <span class="quote-name"><%= quote_of.user.display_name.presence || quote_of.user.username %></span>
            <span class="quote-handle">@<%= quote_of.user.username %></span>
          </div>
          <p class="quote-text"><%= truncate(quote_of.body.to_s, length: 200) %></p>
        </div>
      <% end %>

      <%# Alt text is only meaningful alongside an image, so the field is shown
          next to the media button and is optional. %>
      <div class="compose-alt" data-alt-wrap hidden>
        <input type="text" name="alt_text" maxlength="1000" autocomplete="off"
               placeholder="Describe this image for people who cannot see it"
               aria-label="Image description">
      </div>

      <div class="compose-bar">
        <%# The 2019 toolbar led with media. Images and video go through the
            file picker; GIF is its own control because a GIF commonly arrives
            as a link to a Tenor or Giphy page rather than as a file, and the
            client embedded it rather than making you download it first.
            Both controls sit in one group so they stay together on the left;
            the flexible gap belongs to the group rather than to either button,
            or a second button would be pushed over beside Tweet. %>
        <div class="compose-tools">
          <label class="media-btn" title="Add photos or video">
            <%= icon('image') %>
            <input type="file" name="media" accept="image/*,video/mp4,video/webm,video/quicktime" data-media-input>
          </label>
          <button type="button" class="media-btn" title="Add a GIF" data-gif-open>
            <%= icon('gif') %>
          </button>
          <%# Poll and emoji complete the 2019 toolbar, which read photo, GIF,
              poll, emoji. Emoji took the slot the location button used to hold. %>
          <button type="button" class="media-btn" title="Add a poll" data-poll-open>
            <%= icon('chart-simple') %>
          </button>
          <button type="button" class="media-btn" title="Add an emoji" data-emoji-open>
            <span class="emoji-glyph" aria-hidden="true">&#x1F600;</span>
          </button>
          <%# The 2019 toolbar ended with the schedule control. It opens a
              panel rather than sending a hidden value, so a post is only
              scheduled when the writer has seen and set the moment. %>
          <button type="button" class="media-btn schedule-btn" title="Schedule this tweet"
                  data-schedule-open aria-expanded="false">
            <%= icon('clock') %>
            <span class="schedule-chip" data-schedule-chip hidden></span>
          </button>
        </div>
        <span class="tweet-counter counter" data-counter-output><%= @max_len %></span>
        <button class="btn primary-btn tweet-btn" type="submit">Tweet</button>
      </div>

      <%# The schedule panel. The value is a single local string so the server
          reads it in one place; "Clear" removes it, which turns the composer
          back into an ordinary post made now. %>
      <div class="schedule-panel" data-schedule-panel hidden>
        <div class="gif-head">
          <span>Schedule tweet</span>
          <button type="button" class="gif-close" data-schedule-close aria-label="Close"><%= icon('xmark') %></button>
        </div>
        <label class="schedule-field">
          Date and time
          <input type="text" class="schedule-input" data-schedule-input
                 autocomplete="off" placeholder="YYYY-MM-DD HH:MM" aria-label="Schedule date and time">
        </label>
        <p class="gif-note" data-schedule-note hidden></p>
        <div class="schedule-actions">
          <button type="button" class="btn schedule-clear" data-schedule-clear>Clear</button>
          <button type="button" class="btn gif-use-link" data-schedule-set>Set schedule</button>
        </div>
        <input type="hidden" name="scheduled_at" data-schedule-hidden>
      </div>

      <%# The emoji picker. A short palette of the faces and symbols the 2019
          picker opened with; choosing one inserts it at the caret rather than
          replacing the draft, and the picker stays open so several can be
          added in a row. %>
      <div class="emoji-panel" data-emoji-panel hidden>
        <div class="emoji-head">
          <span>Emoji</span>
          <button type="button" class="gif-close" data-emoji-close aria-label="Close"><%= icon('xmark') %></button>
        </div>
        <div class="emoji-grid">
          <% %w[😀 😃 😄 😁 😆 😅 😂 🤣 😊 😇 🙂 😉 😍 😘 😗 😙 😚 😋 😜 😝 🤗 🤔 🤨 😐 😑 😶 🙄 😏 😣 😥 😮 🤐 😯 😪 😴 😌 😛 😕 🙁 😞 😖 😫 😩 🥺 😢 😭 😤 😠 😡 🤬 🤯 😳 🥵 🥶 😱 😨 😰 😥 😓 🤢 🤮 🤧 😷 🤒 🤕 🤠 😎 🤓 🧐 🤡 🥳 🥰 🤝 👍 👎 👏 🙌 🙏 💪 🔥 ✨ 🎉 💯 ❤️ 🧡 💛 💚 💙 💜 🖤].each do |glyph| %>
            <button type="button" class="emoji-item" data-emoji="<%= glyph %>"><%= glyph %></button>
          <% end %>
        </div>
      </div>

      <%# The poll builder. Two choices are shown from the start because that is
          the minimum a poll can have; Add choice reveals the remaining two, and
          the control disappears once all four are in use. %>
      <div class="poll-panel" data-poll-panel hidden>
        <div class="gif-head">
          <span>Add a poll</span>
          <button type="button" class="gif-close" data-poll-close aria-label="Close"><%= icon('xmark') %></button>
        </div>
        <div class="poll-choices" data-poll-choices>
          <% 4.times do |index| %>
            <div class="poll-choice" <%= "hidden" if index >= 2 %> data-poll-choice>
              <input type="text" name="poll[options][]" class="poll-input" autocomplete="off"
                     maxlength="<%= Poll::MAX_LABEL %>" placeholder="Choice <%= index + 1 %>"
                     aria-label="Poll choice <%= index + 1 %>">
            </div>
          <% end %>
        </div>
        <div class="poll-foot">
          <button type="button" class="btn poll-add" data-poll-add>Add choice</button>
          <label class="poll-duration">
            Poll length
            <select name="poll[duration]" aria-label="Poll length">
              <% { "5m" => "5 minutes", "30m" => "30 minutes", "1h" => "1 hour",
                   "1d" => "1 day", "3d" => "3 days", "1w" => "1 week" }.each do |key, label| %>
                <option value="<%= key %>" <%= "selected" if key == "1d" %>><%= label %></option>
              <% end %>
            </select>
          </label>
          <button type="button" class="btn poll-remove" data-poll-close>Remove poll</button>
        </div>
        <p class="gif-note" data-poll-note hidden></p>
      </div>

      <%# The GIF panel. A pasted link is embedded directly; a chosen file is
          uploaded like any other attachment. Both end in the same `media_path`,
          so a posted GIF is an ordinary attachment wherever it came from. %>
      <div class="gif-panel" data-gif-panel hidden>
        <div class="gif-head">
          <span>Add a GIF</span>
          <button type="button" class="gif-close" data-gif-close aria-label="Close"><%= icon('xmark') %></button>
        </div>
        <input type="text" class="gif-url" data-gif-url autocomplete="off"
               placeholder="Paste a GIF link (Tenor, Giphy, ...)" aria-label="GIF link">
        <div class="gif-actions">
          <button type="button" class="btn gif-use-link" data-gif-use-link>Use link</button>
          <label class="gif-file">
            <%= icon('image') %> Choose a GIF file
            <input type="file" name="gif_file" accept="image/gif" data-gif-file>
          </label>
        </div>
        <p class="gif-note" data-gif-note hidden></p>
      </div>
      <input type="hidden" name="gif_url" data-gif-url-hidden>
    </div>
  <% end %>
</div>
<% content_for :title, "Tweet by @#{@tweet.user.username} / #{@site_name}" %>

<div class="layout">
  <%# The 2019 permalink: a sticky header with the back target, the focused
      tweet set larger than it is in the stream, then the reply composer and the
      conversation below it. %>
  <section class="col-main permalink"
           id="permalink"
           data-tweet="<%= @tweet.id %>"
           data-stats-url="<%= tweet_stats_path(@tweet) %>">
    <div class="stream-head">
      <a class="head-back" href="<%= home_path %>" title="Back">&#8592;</a>
      <div class="stream-head-title">
        <h1>Tweet</h1>
      </div>
    </div>

    <div class="permalink-inner">
      <%# The conversation above this tweet, oldest first, so a reply always
          shows what it was replying to. %>
      <% if @ancestors.present? %>
        <div class="permalink-ancestors">
          <% @ancestors.each do |parent| %>
            <%= render "tweets/tweet", tweet: parent %>
          <% end %>
        </div>
      <% end %>

      <article class="tweet permalink-tweet" data-tweet="<%= @tweet.id %>">
        <div class="permalink-header">
          <a class="permalink-avatar" href="<%= profile_path(@tweet.user.username) %>">
            <%= pic(@tweet.user.avatar_path, 48) %>
          </a>
          <div class="permalink-account">
            <a class="permalink-fullname" href="<%= profile_path(@tweet.user.username) %>">
              <%= @tweet.user.display_name.presence || @tweet.user.username %>
            </a>
            <% if @tweet.user.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
            <span class="permalink-username">@<%= @tweet.user.username %></span>
          </div>
        </div>

        <div class="permalink-content">
          <% if @tweet.body.present? %>
            <p class="tweet-text tweet-text-lead"><%= linkify(@tweet.body) %></p>
          <% end %>

          <% if @tweet.media_path.present? %>
            <div class="tweet-media permalink-media">
              <img src="/uploads/<%= @tweet.media_path %>" alt="<%= @tweet.alt_text.to_s %>">
            </div>
          <% end %>

          <%# A quoted post, shown as a card beneath the quoting body. %>
          <% if @tweet.quote_of %>
            <a class="quote-card" href="<%= tweet_path(@tweet.quote_of) %>">
              <div class="quote-head">
                <%= pic(@tweet.quote_of.user.avatar_path, 20) %>
                <span class="quote-name"><%= @tweet.quote_of.user.display_name.presence || @tweet.quote_of.user.username %></span>
                <% if @tweet.quote_of.user.is_verified %><span class="verified-badge"><%= icon('verified') %></span><% end %>
                <span class="quote-handle">@<%= @tweet.quote_of.user.username %></span>
              </div>
              <p class="quote-text"><%= linkify(@tweet.quote_of.body) %></p>
              <% if @tweet.quote_of.media_path.present? %>
                <div class="tweet-media"><img src="/uploads/<%= @tweet.quote_of.media_path %>" alt="<%= @tweet.quote_of.alt_text.to_s %>"></div>
              <% end %>
            </a>
          <% end %>

          <span class="permalink-time"><%= @tweet.created_at.strftime('%-I:%M %p - %-d %b %Y') %></span>

          <%# The permalink keeps the classic count line, which is where the
              detailed figures belong, while the controls below match the
              timeline's icon row. %>
          <div class="tweet-stats">
            <span><strong><%= count_label(@tweet.retweet_count) %></strong> Retweets</span>
            <span><strong><%= count_label(@tweet.favourite_count) %></strong> Favorites</span>
            <span><strong><%= count_label(@tweet.like_count) %></strong> Likes</span>
            <span><strong><%= count_label(@replies.size) %></strong> Replies</span>
          </div>

          <% rt_active = @tweet.retweeted_by?(current_user) %>
          <% fav_active = @tweet.favourited_by?(current_user) %>
          <% like_active = @tweet.liked_by?(current_user) %>
          <div class="tweet-actions permalink-actions">
            <a class="act act-reply" href="#reply" title="Reply">
              <%= icon('reply') %>
              <% if @replies.size.positive? %><span class="act-count"><%= count_label(@replies.size) %></span><% end %>
            </a>
            <%= form_with url: retweet_tweet_path(@tweet), method: :post, class: "inline js-retweet" do %>
              <button class="act act-rt <%= 'rt-active' if rt_active %>" type="submit"
                      title="<%= rt_active ? 'Undo retweet' : 'Retweet' %>">
                <%= icon('retweet') %>
                <% if rt_active %>
                  <span class="act-count">Retweeted</span>
                <% elsif @tweet.retweet_count.positive? %>
                  <span class="act-count"><%= count_label(@tweet.retweet_count) %></span>
                <% end %>
              </button>
            <% end %>
            <%= form_with url: favorite_tweet_path(@tweet), method: :post,
                          class: "inline js-fav",
                          data: { favourited: fav_active, fav_url: favorite_tweet_path(@tweet),
                                  unfav_url: favorite_tweet_path(@tweet) } do %>
              <button class="act act-fav <%= 'faved' if fav_active %>" type="submit" title="Favorite">
                <%= icon(fav_active ? 'star-solid' : 'star-regular') %>
                <% if fav_active %>
                  <span class="act-count">Favorited</span>
                <% elsif @tweet.favourite_count.positive? %>
                  <span class="act-count"><%= count_label(@tweet.favourite_count) %></span>
                <% end %>
              </button>
            <% end %>
            <%= form_with url: like_tweet_path(@tweet), method: :post,
                          class: "inline js-like",
                          data: { liked: like_active, like_url: like_tweet_path(@tweet),
                                  unlike_url: like_tweet_path(@tweet) } do %>
              <button class="act act-heart <%= 'hearted' if like_active %>" type="submit" title="Like">
                <%= icon(like_active ? 'heart-twitter-solid' : 'heart-twitter') %>
                <% if like_active %>
                  <span class="act-count">Liked</span>
                <% elsif @tweet.like_count.positive? %>
                  <span class="act-count"><%= count_label(@tweet.like_count) %></span>
                <% end %>
              </button>
            <% end %>
            <%# Saving and the overflow menu, matching the timeline's row. %>
            <% saved = @tweet.bookmarked_by?(current_user) %>
            <%= form_with url: bookmark_tweet_path(@tweet), method: :post,
                          class: "inline js-bookmark",
                          data: { bookmarked: saved, save_url: bookmark_tweet_path(@tweet),
                                  unsave_url: bookmark_tweet_path(@tweet) } do %>
              <button class="act act-save <%= 'saved' if saved %>" type="submit"
                      title="<%= saved ? 'Remove from saved posts' : 'Save post' %>">
                <%= icon(saved ? 'bookmark-solid' : 'bookmark-regular') %>
              </button>
            <% end %>
            <% if @tweet.user_id == current_user.id || can?('tweets.delete') %>
              <%= form_with url: tweet_path(@tweet), method: :delete, class: "inline",
                            html: { onsubmit: "return confirm('Delete this tweet?')" } do %>
                <button class="act act-del" type="submit" title="Delete">&#215;</button>
              <% end %>
            <% end %>
            <details class="tweet-menu tweet-menu-inline">
              <summary aria-label="More options"><%= icon('ellipsis') %></summary>
              <div class="tweet-menu-list">
                <% if @tweet.user_id != current_user.id && !@tweet.retweet_of_id %>
                  <a href="<%= tweet_path(@tweet, quote: 1) %>">Quote Tweet</a>
                <% end %>
                <% if @tweet.user_id == current_user.id %>
                  <a href="<%= tweet_activity_path(@tweet) %>">View Tweet activity</a>
                <% end %>
                <a href="<%= tweet_path(@tweet) %>" data-copy-link="<%= tweet_url(@tweet) %>">Copy link to Tweet</a>
                <% if @tweet.user_id != current_user.id %>
                  <a href="<%= new_report_path(tweet_id: @tweet.id) %>">Report Tweet</a>
                <% end %>
              </div>
            </details>
          </div>
        </div>
      </article>
    </div>

    <%= render "tweets/composer", parent_id: @tweet.id, quote_of: @quote_of,
                                  placeholder: @quote_of ? "Add a comment" : "Reply to @#{@tweet.user.username}" %>

    <%# Hidden replies are the author's own moderation. The author sees the
        count and can put them back; everyone else simply does not see them. %>
    <% if @hidden_count.to_i.positive? && @tweet.user_id == current_user.id %>
      <div class="hidden-note">
        <%= @hidden_count %> <%= 'reply'.pluralize(@hidden_count) %> hidden from the conversation.
      </div>
    <% end %>

    <ul class="timeline permalink-replies">
      <% if @replies.present? %>
        <% @replies.each do |reply| %>
          <%= render "tweets/tweet", tweet: reply %>
          <%# Hiding is the original author's decision, so the control is only
              rendered for them and only on somebody else's reply. %>
          <% if reply.parent.user_id == current_user.id && reply.user_id != current_user.id %>
            <li class="reply-moderation">
              <%= form_with url: hide_reply_path(reply),
                            method: reply.reply_hidden? ? :delete : :post, class: "inline" do %>
                <button class="btn btn-quiet btn-tiny" type="submit">
                  <%= reply.reply_hidden? ? "Unhide reply" : "Hide reply" %>
                </button>
              <% end %>
            </li>
          <% end %>
        <% end %>
      <% else %>
        <li class="empty">No replies yet.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail" %>
  </aside>
</div>
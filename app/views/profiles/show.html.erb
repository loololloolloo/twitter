<%# The title follows the account's real state: only a permanently banned
    account is an "Account suspended" page. %>

<% if @user.permanently_banned? %>
  <%# A permanently banned account keeps its handle visible so the page still
      resolves, but every personal detail is withheld - name, picture, bio,
      location, links and counts - and the picture falls back to the default.
      The layout is the same 2019 profile with the details removed, so a banned
      profile is not a different shape from a normal one. %>
  <div class="profile-header">
    <div class="profile-canopy no-banner">
      <div class="statbar-avatar">
        <div class="statbar-avatar-frame"><%= pic(nil, 200) %></div>
      </div>
    </div>

    <div class="profile-details">
      <div class="profile-details-head">
        <div class="profile-details-name">
          <h1 class="profile-name"><span class="muted">Account suspended</span></h1>
          <div class="profile-screenname">@<%= @user.username %></div>
        </div>
        <div class="profile-actions"></div>
      </div>

      <div class="profile-bio-wrap">
        <p class="profile-banned-label"><%= icon('ban') %> Account permanently banned</p>
        <p class="profile-banned-note muted">
          This account has been permanently banned and its information is no longer available.
        </p>
      </div>
    </div>
  </div>
<% else %>
<%# A block hides both accounts from each other. The page still resolves so the
    relationship can be undone from here, but no content is shown. %>
<% if @blocked %>
  <div class="layout">
    <section class="col-main">
      <div class="stream-head">
        <a class="head-back" href="<%= home_path %>" title="Back">&#8592;</a>
        <div class="stream-head-title"><h1>@<%= @user.username %></h1></div>
      </div>
      <div class="block-notice">
        <h2>You blocked @<%= @user.username %></h2>
        <p class="muted">
          You cannot follow each other, see each other's posts, or message each
          other while the block is in place.
        </p>
        <%= form_with url: block_user_path(@user.username), method: :delete, class: "inline" do %>
          <button class="btn btn-primary" type="submit">Unblock</button>
        <% end %>
      </div>
    </section>
    <aside class="col-right">
      <%= render "shared/rail" %>
    </aside>
  </div>
<% else %>
<%# The 2019 profile. It is one card in the centre column:
      - a sticky header naming the account and its tweet count,
      - a full-bleed 199.5px banner with the 134px picture anchored inside it,
      - the details block, where the picture tucks into the first row,
      - the tab strip (Tweets / Tweets & replies / Media / Likes),
      - the stream.
    The picture is a child of the banner so it can never drift into the metrics
    when the layout narrows. %>
<div class="layout">
  <section class="col-main">
    <div class="stream-head">
      <a class="head-back" href="<%= home_path %>" title="Back">&#8592;</a>
      <div class="stream-head-title">
        <h1><%= @user.display_name %></h1>
        <span class="stream-head-sub"><%= count_label(@tweet_count) %> Tweets</span>
      </div>
    </div>

    <div class="profile-header">
      <div class="profile-canopy <%= @user.banner_path.present? ? 'has-banner' : 'no-banner' %>"
           <% if @user.banner_path.present? %>style="background-image:url('/uploads/<%= @user.banner_path %>')"<% end %>>
        <div class="statbar-avatar">
          <div class="statbar-avatar-frame"><%= pic(@user.avatar_path, 200) %></div>
        </div>
      </div>

      <div class="profile-details">
        <div class="profile-details-head">
          <div class="profile-actions">
            <% if @is_me %>
              <a class="btn btn-edit" href="<%= settings_path %>">Edit profile</a>
            <% else %>
              <a class="btn btn-msg" href="<%= conversation_path(@user.id) %>" title="Message">Message</a>
              <%# A protected account's follow is a request, so the button says
                  so and reflects whether one is already waiting. %>
              <% if @is_following %>
                <%= form_with url: follow_user_path(@user.username), method: :delete, class: "inline" do %>
                  <button class="btn btn-following" type="submit">Following</button>
                <% end %>
              <% elsif @request_pending %>
                <%= form_with url: follow_user_path(@user.username), method: :delete, class: "inline" do %>
                  <button class="btn btn-following" type="submit">Requested</button>
                <% end %>
              <% else %>
                <%= form_with url: follow_user_path(@user.username), method: :post, class: "inline" do %>
                  <button class="btn btn-follow" type="submit">
                    <%= @user.protected? ? "Request to follow" : "Follow" %>
                  </button>
                <% end %>
              <% end %>

              <%# The overflow menu carries the actions that are not primary:
                  muting, blocking and reporting. %>
              <details class="tweet-menu tweet-menu-inline">
                <summary aria-label="More options"><%= icon('ellipsis') %></summary>
                <div class="tweet-menu-list">
                  <% if @muted %>
                    <%= button_to "Unmute @#{@user.username}", mute_user_path(@user.username),
                                  method: :delete, class: "menu-button" %>
                  <% else %>
                    <%= button_to "Mute @#{@user.username}", mute_user_path(@user.username),
                                  method: :post, class: "menu-button" %>
                  <% end %>
                  <%= button_to "Block @#{@user.username}", block_user_path(@user.username),
                                method: :post, class: "menu-button",
                                form: { onsubmit: "return confirm('Block @#{@user.username}?')" } %>
                  <a href="<%= new_report_path(username: @user.username) %>">Report @<%= @user.username %></a>
                </div>
              </details>
            <% end %>
          </div>
        </div>

        <div class="profile-details-name">
          <h1 class="profile-name">
            <%= @user.display_name %>
            <% if @user.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
            <% if @user.protected? %><span class="lock-badge" title="Protected account"><%= icon('lock') %></span><% end %>
          </h1>
          <div class="profile-screenname">
            @<%= @user.username %>
            <%# The 2019 header marked an account that follows the viewer, so the
                relationship reads before the bio does. Only shown to the viewer
                and never on your own profile. %>
            <% if @follows_me %><span class="follows-you">Follows you</span><% end %>
          </div>
        </div>

        <div class="profile-bio-wrap">
          <% if @user.bio.present? %><p class="profile-bio"><%= linkify(@user.bio) %></p><% end %>

          <div class="profile-fields">
            <% if @user.location.present? %>
              <span><%= icon('location-dot') %> <%= @user.location %></span>
            <% end %>
            <% if @user.website.present? %>
              <span><%= icon('link') %> <a href="<%= @user.website %>" target="_blank" rel="me nofollow noopener"><%= display_url(@user.website) %></a></span>
            <% end %>
            <span><%= icon('clock') %> Joined <%= joined(@user.created_at) %></span>
          </div>

          <%# The 2019 profile shows the follow counts as plain text under the
              bio. The Likes total that the earlier client carried here was
              dropped in the redesign, and the Likes tab lists the posts the
              account reacted to, which is a different thing entirely. %>
          <p class="profile-follow-counts">
            <a href="<%= following_path(@user.username) %>"><strong><%= @following_count %></strong> Following</a>
            <a href="<%= followers_path(@user.username) %>"><strong><%= count_label(@follower_count) %></strong> Followers</a>
          </p>
        </div>
      </div>

      <ul class="profile-tabs">
        <li class="pt-item <%= 'is-active' if @active == 'tweets' %>">
          <% if @active == 'tweets' %><span>Tweets</span>
          <% else %><a href="<%= profile_path(@user.username) %>">Tweets</a><% end %>
        </li>
        <li class="pt-item <%= 'is-active' if @active == 'replies' %>">
          <% if @active == 'replies' %><span>Tweets &amp; replies</span>
          <% else %><a href="<%= profile_path(@user.username, tab: 'replies') %>">Tweets &amp; replies</a><% end %>
        </li>
        <li class="pt-item <%= 'is-active' if @active == 'media' %>">
          <% if @active == 'media' %><span>Media</span>
          <% else %><a href="<%= profile_path(@user.username, tab: 'media') %>">Media</a><% end %>
        </li>
        <li class="pt-item <%= 'is-active' if @active == 'likes' %>">
          <% if @active == 'likes' %><span>Likes</span>
          <% else %><a href="<%= profile_path(@user.username, tab: 'likes') %>">Likes</a><% end %>
        </li>
        <%# The scheduled queue belongs to the writer alone, so the tab only
            appears on your own profile. %>
        <% if @is_me %>
          <li class="pt-item <%= 'is-active' if @active == 'scheduled' %>">
            <% if @active == 'scheduled' %><span>Scheduled</span>
            <% else %><a href="<%= profile_path(@user.username, tab: 'scheduled') %>">Scheduled</a><% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <% if @locked %>
      <%# A protected account the viewer does not follow: header and counts are
          shown, the stream is replaced by an explanation. %>
      <div class="lock-notice">
        <p><%= icon('lock') %> @<%= @user.username %>'s Tweets are protected.</p>
        <p class="muted">
          Only approved followers can see @<%= @user.username %>'s Tweets. Once
          they accept your request, you will be able to see them.
        </p>
      </div>
    <% elsif @active == "media" %>
      <% if @media.present? %>
        <%# The grid is filled a page at a time. The control below is a real
            link, so it works without JavaScript by loading a page that already
            carries everything up to that point; the script upgrades it to
            appending only the newly arrived cells. The page number lives on the
            grid so the script reads it from the same place the link was built. %>
        <div class="media-rail" data-media-grid
             data-media-url="<%= profile_media_path(@user.username) %>"
             data-media-next="<%= @media_next_page %>">
          <%= render "profiles/media_cells", media: @media %>
        </div>
        <div class="media-more" data-media-more <%= "hidden" unless @media_has_more %>>
          <a class="btn load-more-btn" data-media-link
             href="<%= profile_path(@user.username, tab: 'media', page: @media_next_page) %>">
            Load more
          </a>
        </div>
      <% else %>
        <p class="empty profile-empty">No photos or videos yet.</p>
      <% end %>
    <% elsif @active == "scheduled" %>
      <% if @scheduled.present? %>
        <p class="scheduled-note">
          These tweets are not visible to anyone yet. Each one publishes on its
          own at the time shown.
        </p>
        <ul class="timeline scheduled-list">
          <% @scheduled.each do |tweet| %>
            <li class="scheduled-when">
              <%= icon('clock') %>
              Scheduled for <%= tweet.scheduled_at.strftime('%b %-d, %Y at %-I:%M %p') %>
            </li>
            <%= render "tweets/tweet", tweet: tweet %>
          <% end %>
        </ul>
      <% else %>
        <p class="empty profile-empty">Nothing scheduled.</p>
      <% end %>
    <% else %>
      <ul class="timeline">
        <% if @pinned %>
          <li class="pin-flag">
            <span class="pin-label">Pinned Tweet</span>
            <% if @pinned.pinned_at %>
              <span class="pin-when">pinned <%= time_ago(@pinned.pinned_at) %></span>
            <% end %>
          </li>
          <%= render "tweets/tweet", tweet: @pinned %>
        <% end %>

        <% if @tweets.present? %>
          <% @tweets.each do |tweet| %>
            <%= render "tweets/tweet", tweet: tweet %>
          <% end %>
        <% else %>
          <li class="empty profile-empty">
            <% if @active == "likes" %>No likes yet.
            <% elsif @active == "media" %>No photos or videos yet.
            <% elsif @is_me %>You haven't tweeted yet.
            <% else %>No tweets yet.<% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <aside class="col-right profile-aside">
    <%= render "shared/rail", suggestions: @suggestions, trends_title: "Trends for you" %>
  </aside>
</div>
<% end %>
<% end %>

<h1 class="admin-title">Site settings</h1>

<%= form_with url: admin_settings_path, method: :post, class: "settings-form panel" do %>
  <label>Site name
    <input type="text" name="site_name" value="<%= @settings['site_name'] %>">
  </label>
  <label>Tagline / compose placeholder
    <input type="text" name="site_tagline" value="<%= @settings['site_tagline'] %>">
  </label>
  <label>Max tweet length
    <input type="number" name="max_tweet_length" min="1" max="1000"
           value="<%= @settings['max_tweet_length'].presence || 140 %>">
  </label>
  <label class="check">
    <input type="checkbox" name="registration_open" value="1"
           <%= 'checked' if @settings['registration_open'].to_s == '1' %>>
    <span>Registration open</span>
  </label>
  <button class="btn btn-primary" type="submit">Save settings</button>
<% end %>

<% if can?('backup.export') %>
  <div class="panel">
    <h3 class="panel-title">Backup</h3>
    <p class="muted">Download a full SQL dump including schema and all rows.</p>
    <a class="btn btn-primary" href="<%= admin_backup_path %>">Export database (.sql)</a>
  </div>
<% end %>
<%= review_caution(@user) %>

<%# The record header. It is the account's identity and its standing, sized to
    be read at a glance: who it is, what it is, and the one number that decides
    whether the controls below are live. %>
<section class="record-head">
  <div class="record-id">
    <%= pic(@user.avatar_path, 64) %>
    <div class="record-names">
      <h1 class="record-handle">@<%= @user.username %></h1>
      <p class="record-real">
        <%= @user.display_name %>
        <% if @user.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
      </p>
      <div class="tag-row">
        <span class="tag tag-quiet">user #<%= @user.id %></span>
        <span class="tag <%= @user.is_banned || @user.is_suspended ? 'tag-alert' : 'tag-quiet' %>">
          <%= @user.is_banned ? 'banned' : (@user.is_suspended ? 'suspended' : 'active') %>
        </span>
        <span class="tag tag-quiet"><%= @user.role.name %></span>
        <% if @user.is_verified %><span class="tag tag-info">verified</span><% end %>
        <%= account_tag_chips(@user) %>
        <% if @open_reports.positive? %>
          <span class="tag tag-alert"><%= @open_reports %> open report<%= 's' if @open_reports != 1 %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="record-facts">
    <span class="record-fact"><span class="record-fact-label">Email</span>
      <strong><%= @user.email.presence || 'none' %></strong></span>
    <span class="record-fact"><span class="record-fact-label">Joined</span>
      <strong><%= @user.created_at.strftime('%d %b %Y') %></strong></span>
    <span class="record-fact"><span class="record-fact-label">Last login</span>
      <strong><%= @user.last_login_at ? time_ago(@user.last_login_at) : 'never' %></strong></span>
    <span class="record-fact"><span class="record-fact-label">Followers</span>
      <strong><%= count_label(@user.follower_count) %></strong></span>
    <span class="record-fact"><span class="record-fact-label">Posts</span>
      <strong><%= @user.tweet_count %></strong></span>
    <span class="record-fact"><span class="record-fact-label">Permissions</span>
      <strong><%= @held.size %> / <%= @permissions.size %></strong></span>
  </div>

  <p class="record-links">
    <a class="btn btn-mini" href="<%= profile_path(@user.username) %>">View public profile</a>
    <% if may_manage?(@user) && can?('users.impersonate') && @user.id != current_user.id && outranks?(@user) %>
      <%= form_with url: admin_user_impersonate_path(@user), method: :post, class: "inline" do %>
        <button class="btn btn-mini" type="submit">Sign in as @<%= @user.username %></button>
      <% end %>
    <% end %>
    <a class="btn btn-mini" href="<%= admin_users_path %>">Back to accounts</a>
    <% if @open_reports.positive? && can?('reports.view') %>
      <a class="btn btn-mini btn-danger" href="<%= admin_reports_path(state: 'open') %>">
        <%= @open_reports %> open report<%= 's' if @open_reports != 1 %>
      </a>
    <% end %>
  </p>
</section>

<%# Everything below this point writes to the account. When the viewer cannot
    manage it - which is the case for every account but the owner looking at
    itself - none of it is rendered: no tag editor, no email or follower forms,
    no ban, suspend, role, verify or delete controls. What is left is the plain
    read-only card, so there is nothing on the page to alter the account with. %>
<% if may_manage?(@user) %>

<h2 class="group-title">Identity &amp; access</h2>
<div class="detail-grid">
  <div class="panel">
    <h3 class="panel-title">Account state</h3>
    <p>Role: <span class="role-badge"><%= @user.role.name %></span> (rank <%= @user.role.rank %>)</p>
    <p>Status:
      <% if @user.is_banned %><span class="pill pill-bad">banned</span>
      <% elsif @user.is_suspended %><span class="pill pill-bad">suspended</span>
      <% else %><span class="pill pill-ok">active</span><% end %>
    </p>
    <p>Verified: <% if @user.is_verified %><span class="pill">yes</span><% else %><span class="pill">no</span><% end %></p>
    <p>Last login: <span class="muted"><%= @user.last_login_at.presence || 'never' %></span></p>
    <p>Permissions held: <strong><%= @held.size %></strong></p>
  </div>

  <div class="panel">
    <h3 class="panel-title">Identity</h3>
    <p>Email: <strong><%= @user.email.presence || 'none' %></strong></p>
    <p>Domain: <span class="muted"><%= @user.email_domain.presence || 'none' %></span></p>
    <p>
      <% @user.email_flags.each do |label, on| %>
        <span class="pill <%= on ? 'pill-warn' : 'pill' %>"><%= label %><%= on ? '' : ': no' %></span>
      <% end %>
    </p>

    <% if @user.email_protected? %>
      <p class="panel-note">Email is a private domain.</p>
    <% end %>
    <% if @user.email_inactive? %>
      <p class="panel-note">Account is inactive.</p>
    <% end %>
    <% if @user.email_bounced? %>
      <p class="panel-note">Email bounces: this address cannot receive mail.</p>
    <% end %>

    <% if can?('users.email') %>
      <%= form_with url: admin_user_email_path(@user), method: :post, class: "stack" do %>
        <label>Add Email
          <input type="email" name="email" required
                 placeholder="name@example.com" value="<%= @user.email %>">
        </label>
        <button class="btn btn-primary" type="submit">Add Email</button>
      <% end %>
      <p class="panel-note">
        For all emails and email history, use the audit trail below.
      </p>
    <% end %>
  </div>

  <div class="panel">
    <h3 class="panel-title">Followers</h3>
    <p>Real follows: <strong><%= @real_followers %></strong></p>
    <p>Displayed total: <strong><%= count_label(@user.follower_count) %></strong></p>
    <% if can?('users.followers') %>
      <%= form_with url: admin_user_followers_path(@user), method: :post, class: "stack" do %>
        <label>Extra followers
          <input type="number" name="followers" min="0" step="1" value="<%= @user.bonus_followers.to_i %>" required>
        </label>
        <button class="btn btn-primary" type="submit">Update follower count</button>
      <% end %>
    <% end %>
  </div>

  <div class="panel">
    <h3 class="panel-title">Profile picture</h3>
    <p><%= pic(@user.avatar_path, 48) %></p>
    <p class="muted"><%= @user.avatar_path.present? ? 'Has a picture.' : 'Using the default.' %></p>
  </div>
</div>

<h2 class="group-title">Visibility &amp; escalation</h2>
<section class="admin-section">
  <h2 class="section-title">Account tags</h2>
  <p class="section-note">
    Visibility limits and escalation flags. None of these remove the account;
    they record how it should be treated. Every change is written to the audit
    trail.
  </p>

  <% if can?('users.tags') %>
    <%= form_with url: admin_user_tags_path(@user), method: :post do %>
      <div class="stack">
        <div class="tag-editor">
          <% User::ACCOUNT_TAGS.each do |column, label| %>
            <% on = @user.public_send(column) %>
            <label class="tag-toggle <%= 'on' if on %>">
              <input type="checkbox" name="<%= column %>" value="1" <%= 'checked' if on %>>
              <%= label %>
            </label>
          <% end %>
        </div>

        <label>Note
          <input type="text" name="tag_note" value="<%= @user.tag_note %>"
                 placeholder="Why these tags? (shown to other operators)">
        </label>

        <button class="btn btn-primary" type="submit">Save tags</button>
      </div>
    <% end %>
  <% else %>
    <div class="stack">
      <p>Your role cannot change account tags.</p>
      <p><%= account_tag_chips(@user) %></p>
      <p class="muted"><%= @user.tag_note.presence || 'No note.' %></p>
    </div>
  <% end %>
</section>

<h2 class="group-title">Moderation</h2>

<%# The moderation history comes first among the moderation blocks. It is the
    account's record: every warning, ban, suspension and staff change, newest
    first, in one stack rather than scattered across panels. The controls that
    produce new entries sit below it, so the operator reads what has already
    happened before reaching for anything. %>
<section class="admin-section">
  <h3 class="panel-title">Moderation history</h3>
  <p class="section-note">
    Everything staff have done to this account, most recent first. Actions taken
    elsewhere in the panel appear here.
  </p>

  <% if @moderation_history.present? %>
    <ol class="mod-history">
      <% @moderation_history.each do |entry| %>
        <li class="mod-entry mod-<%= entry[:tone] %>">
          <span class="mod-dot" aria-hidden="true"></span>
          <div class="mod-body">
            <div class="mod-head">
              <strong class="mod-label"><%= entry[:label] %></strong>
              <% if entry[:state].present? %>
                <span class="mod-state"><%= entry[:state] %></span>
              <% end %>
              <span class="mod-when">
                <% if entry[:at] %>
                  <%= time_ago(entry[:at]) %>
                <% else %>
                  current
                <% end %>
              </span>
            </div>
            <p class="mod-detail"><%= entry[:detail].presence || 'No detail recorded.' %></p>
            <p class="mod-meta">
              by <%= entry[:actor] ? "@#{entry[:actor].username}" : "system" %>
              <% if entry[:warning] %>
                &middot; warning #<%= entry[:warning].id %>
              <% end %>
            </p>
          </div>
          <% if entry[:warning] && entry[:warning].active? && can?('users.warn') %>
            <%= form_with url: admin_user_warning_revoke_path(@user, entry[:warning]), method: :post, class: "inline" do %>
              <button class="btn btn-mini" type="submit">Revoke</button>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="muted">No moderation actions have been taken against this account.</p>
  <% end %>
</section>

<%# Warnings. A warning changes nothing about the account; it records that the
    account was told. It is therefore its own block rather than folded into the
    ban panel, which does change the account. %>
<section class="admin-section">
  <h3 class="panel-title">Warnings</h3>
  <p class="section-note">
    A warning is a formal notice. It does not restrict the account; it records
    that the account was told, so the next operator can see the history.
  </p>

  <p class="warn-summary">
    <% if @active_warnings.positive? %>
      <span class="pill pill-warn"><%= @active_warnings %> active</span>
    <% else %>
      <span class="pill pill-ok">none active</span>
    <% end %>
    <span class="muted"><%= @warnings.size %> issued in total</span>
  </p>

  <% if can?('users.warn') && @user.id != current_user.id %>
    <%= form_with url: admin_user_warn_path(@user), method: :post, class: "stack" do %>
      <label>Category
        <select name="category">
          <% UserWarning::CATEGORIES.each do |value, label| %>
            <option value="<%= value %>"><%= label %></option>
          <% end %>
        </select>
      </label>
      <label>Reason
        <input type="text" name="reason" required
               placeholder="What was this account warned about?">
      </label>
      <label>Duration
        <select name="duration">
          <% @warning_choices.each do |value, label| %>
            <option value="<%= value %>"><%= label %></option>
          <% end %>
        </select>
      </label>
      <button class="btn btn-danger" type="submit">Issue warning</button>
    <% end %>
  <% elsif @user.id == current_user.id %>
    <p class="muted">You cannot warn your own account.</p>
  <% else %>
    <p class="muted">Your role cannot issue warnings.</p>
  <% end %>
</section>

<h3 class="section-title">Sanctions &amp; staff controls</h3>
<div class="detail-grid">
  <div class="panel">
    <h3 class="panel-title">Ban</h3>
    <% if @user.is_banned %>
      <p><strong>Reason:</strong> <%= @user.ban_reason.presence || 'none given' %></p>
      <p><strong>Duration:</strong>
        <% if @user.ban_permanent %>
          permanent
        <% else %>
          <%= @user.ban_expires_at&.strftime('%Y-%m-%d %H:%M:%S') %>
          (<%= humanize_until(@user.ban_expires_at) %> from now)
        <% end %>
      </p>
      <% if can?('users.ban') %>
        <%= form_with url: admin_user_unban_path(@user), method: :post do %>
          <button class="btn btn-follow" type="submit">Unban user</button>
        <% end %>
      <% end %>
    <% else %>
      <p class="muted">This account is not banned.</p>
      <% if can?('users.ban') && @user.id != current_user.id %>
        <%= form_with url: admin_user_ban_path(@user), method: :post, class: "stack" do %>
          <label>Reason
            <input type="text" name="reason" required placeholder="Why is this account being banned?">
          </label>
          <label>Duration
            <select name="duration">
              <option value="permanent">Permanent (no expiry)</option>
              <% @ban_choices.each do |value, label| %>
                <option value="<%= value %>"><%= label %></option>
              <% end %>
            </select>
          </label>
          <button class="btn btn-danger" type="submit">Ban user</button>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="panel">
    <h3 class="panel-title">Actions</h3>
    <% if can?('users.roles') %>
      <%= form_with url: admin_user_role_path(@user), method: :post, class: "stack" do %>
        <label>Assign role
          <select name="role">
            <% @roles.each do |role| %>
              <option value="<%= role.name %>" <%= 'selected' if role.name == @user.role.name %>>
                <%= role.name %> (rank <%= role.rank %>)
              </option>
            <% end %>
          </select>
        </label>
        <button class="btn btn-primary" type="submit">Update role</button>
      <% end %>
    <% end %>

    <div class="action-row">
      <% if can?('users.suspend') %>
        <%= form_with url: admin_user_suspend_path(@user), method: :post do %>
          <button class="btn <%= @user.is_suspended ? 'btn-follow' : 'btn-danger' %>" type="submit">
            <%= @user.is_suspended ? 'Reinstate user' : 'Suspend user' %>
          </button>
        <% end %>
      <% end %>
      <% if can?('users.verify') %>
        <%= form_with url: admin_user_verified_path(@user), method: :post do %>
          <button class="btn btn-follow" type="submit">
            <%= @user.is_verified ? 'Remove verified badge' : 'Grant verified badge' %>
          </button>
        <% end %>
      <% end %>
      <% if can?('users.delete') %>
        <%= form_with url: admin_user_path(@user), method: :delete,
                      html: { onsubmit: "return confirm('Permanently delete this user and all their content?')" } do %>
          <button class="btn btn-danger" type="submit">Delete account</button>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<h2 class="group-title">Access</h2>
<h3 class="section-title">Permissions from role</h3>
<div class="perm-chips">
  <% @permissions.each do |permission| %>
    <span class="chip <%= @held.include?(permission.key) ? 'chip-on' : 'chip-off' %>"><%= permission.key %></span>
  <% end %>
</div>

<h2 class="group-title">Activity</h2>
<h3 class="section-title">Recent posts</h3>
<section class="admin-section">
  <table class="data-table">
    <thead><tr><th class="id">ID</th><th>Body</th><th>When</th><th></th></tr></thead>
    <tbody>
      <% if @tweets.present? %>
        <% @tweets.each do |tweet| %>
          <tr>
            <td class="id"><%= tweet.id %></td>
            <td><%= tweet.body.presence || '(media)' %></td>
            <td class="muted"><%= time_ago(tweet.created_at) %></td>
            <td>
              <% if can?('tweets.delete') %>
                <%= form_with url: admin_tweet_path(tweet), method: :delete, class: "inline" do %>
                  <button class="btn btn-mini btn-danger" type="submit">Delete</button>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr><td colspan="4" class="muted">No posts.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<h3 class="section-title">Audit trail for this account</h3>
<section class="admin-section">
  <table class="data-table">
    <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Detail</th></tr></thead>
    <tbody>
      <% if @log.present? %>
        <% @log.each do |entry| %>
          <tr>
            <td class="muted"><%= time_ago(entry.created_at) %></td>
            <td><%= entry.actor ? "@#{entry.actor.username}" : "system" %></td>
            <td><code><%= entry.action %></code></td>
            <td><%= entry.detail %></td>
          </tr>
        <% end %>
      <% else %>
        <tr><td colspan="4" class="muted">No entries.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>

<% else %>
<%# The read-only card. It is the same account facts the editable screen shows,
    with none of the controls: an operator who cannot manage this account still
    sees who it is, what it is, and how it is doing, and nothing more. %>
<h2 class="group-title">Identity &amp; access</h2>
<div class="detail-grid">
  <div class="panel">
    <h3 class="panel-title">Account state</h3>
    <p>Role: <span class="role-badge"><%= @user.role.name %></span> (rank <%= @user.role.rank %>)</p>
    <p>Status:
      <% if @user.is_banned %><span class="pill pill-bad">banned</span>
      <% elsif @user.is_suspended %><span class="pill pill-bad">suspended</span>
      <% else %><span class="pill pill-ok">active</span><% end %>
    </p>
    <p>Verified: <% if @user.is_verified %><span class="pill">yes</span><% else %><span class="pill">no</span><% end %></p>
    <p>Last login: <span class="muted"><%= @user.last_login_at.presence || 'never' %></span></p>
    <p>Followers: <strong><%= count_label(@user.follower_count) %></strong></p>
    <p>Posts: <strong><%= @user.tweet_count %></strong></p>
  </div>

  <div class="panel">
    <h3 class="panel-title">Identity</h3>
    <p>Username: <strong>@<%= @user.username %></strong></p>
    <p>Display name: <strong><%= @user.display_name %></strong></p>
    <p>Joined: <strong><%= @user.created_at.strftime('%d %b %Y') %></strong></p>
    <p>Email: <span class="muted">private</span></p>
    <p class="panel-note">
      This account can only be changed by signing in as it.
    </p>
  </div>
</div>
<% end %>

<div class="page-head">
  <div>
    <h1>Tweets</h1>
    <p class="page-note">Every post on the site, including deleted ones on request.</p>
  </div>
</div>

<form class="admin-filter" method="get">
  <input type="text" name="q" placeholder="Search tweet text" value="<%= @search %>">
  <label class="check">
    <input type="checkbox" name="deleted" value="1" <%= 'checked' if @include_deleted %>>
    <span>Show deleted</span>
  </label>
  <button class="btn btn-primary" type="submit">Search</button>
</form>

<table class="data-table">
  <thead>
    <tr><th class="id">ID</th><th>Author</th><th>Body</th><th class="num">Likes</th><th class="num">Replies</th><th>When</th><th></th></tr>
  </thead>
  <tbody>
    <% if @tweets.present? %>
      <% @tweets.each do |tweet| %>
        <tr class="<%= 'row-suspended' if tweet.is_deleted %>">
          <td class="id"><%= tweet.id %></td>
          <td>
            <a href="<%= profile_path(tweet.user.username) %>">@<%= tweet.user.username %></a>
            <% if tweet.user.reach_limited? %>
              <span class="tag tag-limit" title="This account carries a visibility limit">limited</span>
            <% end %>
          </td>
          <td>
            <% if tweet.pinned_at %><span class="tag tag-info">pinned</span><% end %>
            <%= tweet.body.presence || '(media)' %>
            <% if tweet.is_deleted %><span class="tag tag-alert">deleted</span><% end %>
          </td>
          <td class="num"><%= tweet.like_count %></td>
          <td class="num"><%= tweet.reply_count %></td>
          <td class="muted"><%= time_ago(tweet.created_at) %></td>
          <td>
            <a class="btn btn-mini" href="<%= tweet_path(tweet) %>">View</a>
            <% if can?('tweets.pin') && !tweet.is_deleted %>
              <% if tweet.pinned_at %>
                <%= button_to "Unpin", admin_tweet_unpin_path(tweet),
                              class: "btn btn-mini", form_class: "inline" %>
              <% else %>
                <%= button_to "Pin", admin_tweet_pin_path(tweet),
                              class: "btn btn-mini", form_class: "inline" %>
              <% end %>
            <% end %>
            <% if can?('tweets.delete') && !tweet.is_deleted %>
              <%= form_with url: admin_tweet_path(tweet), method: :delete, class: "inline",
                            html: { onsubmit: "return confirm('Remove this tweet?')" } do %>
                <button class="btn btn-mini btn-danger" type="submit">Delete</button>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr><td colspan="7" class="muted">No tweets.</td></tr>
    <% end %>
  </tbody>
</table>
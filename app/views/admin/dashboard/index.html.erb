<% content_for :title, "Admin / #{@site_name}" %>

<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="page-note">Everything happening on <%= @site_name %>, at a glance.</p>
  </div>
</div>

<div class="stat-grid">
  <div class="stat"><span class="stat-num"><%= count_label(@stats[:users]) %></span><span class="stat-label">Users</span></div>
  <div class="stat"><span class="stat-num"><%= count_label(@stats[:tweets]) %></span><span class="stat-label">Tweets</span></div>
  <div class="stat"><span class="stat-num"><%= count_label(@stats[:likes]) %></span><span class="stat-label">Likes</span></div>
  <div class="stat"><span class="stat-num"><%= count_label(@stats[:follows]) %></span><span class="stat-label">Follows</span></div>
  <div class="stat"><span class="stat-num"><%= count_label(@stats[:notifications]) %></span><span class="stat-label">Notifications</span></div>
  <div class="stat warn"><span class="stat-num"><%= count_label(@stats[:suspended]) %></span><span class="stat-label">Suspended</span></div>
  <div class="stat warn"><span class="stat-num"><%= count_label(@stats[:banned]) %></span><span class="stat-label">Banned</span></div>
</div>

<section class="admin-section">
  <h2 class="section-title">Roles</h2>
  <table class="data-table">
    <thead><tr><th>Role</th><th>Rank</th><th>Members</th><th>Permissions</th></tr></thead>
    <tbody>
      <% @roles.each do |role| %>
        <tr>
          <td><strong><%= role.name %></strong><br><span class="muted"><%= role.description %></span></td>
          <td><%= role.rank %></td>
          <td><%= @role_user_counts[role.name].to_i %></td>
          <td>
            <% if role.name == Role::OWNER %>
              <span class="pill pill-all">all <%= @permissions.size %></span>
            <% else %>
              <span class="pill"><%= @role_grants[role.name].to_a.size %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="admin-section">
  <h2 class="section-title">Recent activity</h2>
  <table class="data-table">
    <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th><th>Detail</th></tr></thead>
    <tbody>
      <% if @recent.present? %>
        <% @recent.each do |entry| %>
          <tr>
            <td class="muted"><%= time_ago(entry.created_at) %></td>
            <td><%= entry.actor ? "@#{entry.actor.username}" : "system" %></td>
            <td><code><%= entry.action %></code></td>
            <td class="muted"><%= entry.target %></td>
            <td><%= entry.detail %></td>
          </tr>
        <% end %>
      <% else %>
        <tr><td colspan="5" class="muted">No activity yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</section>
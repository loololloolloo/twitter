<%# The 2019 settings screen: a sticky header, a left column of section links
    and one detail column showing the selected section. Only the chosen section
    is rendered, so the page is short instead of every control stacked at once. %>
<% section = (@section.presence || "account") %>

<div class="layout">
  <section class="col-main">
    <div class="stream-head">
      <a class="head-back" href="<%= home_path %>" title="Back">&#8592;</a>
      <div class="stream-head-title">
        <h1>Settings and privacy</h1>
      </div>
    </div>

    <div class="settings-shell">
      <nav class="settings-nav" aria-label="Settings sections">
        <a class="settings-nav-link <%= 'is-active' if section == 'account' %>"
           href="<%= settings_path(panel: 'account') %>">Account</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'security' %>"
           href="<%= settings_path(panel: 'security') %>">Security and account access</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'privacy' %>"
           href="<%= settings_path(panel: 'privacy') %>">Privacy and safety</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'notifications' %>"
           href="<%= settings_path(panel: 'notifications') %>">Notifications</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'preferences' %>"
           href="<%= settings_path(panel: 'preferences') %>">Preferences</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'accessibility' %>"
           href="<%= settings_path(panel: 'accessibility') %>">Accessibility, display, and languages</a>
        <a class="settings-nav-link <%= 'is-active' if section == 'data' %>"
           href="<%= settings_path(panel: 'data') %>">Your account data</a>
      </nav>

      <div class="settings-detail">
        <% case section %>
        <% when 'security' %>
          <h2 class="settings-panel-title">Security and account access</h2>
          <p class="settings-panel-note">
            Keep your account safe by changing the password used to sign in.
          </p>

          <div class="settings-block">
            <h3 class="settings-block-title">Password</h3>
            <%= form_with url: password_path, method: :patch, class: "settings-form" do %>
              <%= hidden_field_tag :panel, "security" %>
              <div class="settings-field">
                <label for="settings-current-password">Current password</label>
                <input id="settings-current-password" type="password" name="current_password"
                       autocomplete="current-password">
              </div>
              <div class="settings-field">
                <label for="settings-new-password">New password</label>
                <input id="settings-new-password" type="password" name="password"
                       autocomplete="new-password">
              </div>
              <div class="settings-field">
                <label for="settings-confirm-password">Confirm password</label>
                <input id="settings-confirm-password" type="password" name="password_confirm"
                       autocomplete="new-password">
              </div>
              <button class="btn primary-btn" type="submit">Change password</button>
            <% end %>
          </div>

        <% when 'privacy' %>
          <h2 class="settings-panel-title">Privacy and safety</h2>
          <p class="settings-panel-note">
            These actions only ever affect your own account. Nothing here touches
            anybody else's posts or messages.
          </p>

          <div class="settings-block">
            <h3 class="settings-block-title">Tweet privacy</h3>
            <p class="settings-block-note">
              When your Tweets are protected, only people you approve can see
              them. Your followers must be approved before they can see your
              Tweets, and your Tweets will not appear in public search results.
            </p>
            <%= form_with url: privacy_settings_path, method: :patch, class: "settings-form" do %>
              <%= hidden_field_tag :panel, "privacy" %>
              <label class="checkbox-row" for="settings-protected">
                <input id="settings-protected" type="checkbox" name="protected" value="1"
                       <%= "checked" if current_user.protected? %>>
                <span>Protect my Tweets</span>
              </label>
              <%= button_tag "Save", class: "btn btn-primary", type: "submit" %>
            <% end %>
          </div>

          <div class="settings-block">
            <h3 class="settings-block-title">Your posts</h3>
            <p class="settings-block-note">
              Delete every tweet you have posted. Replies and retweets other
              people made stay on the site. This cannot be undone.
            </p>
            <%= form_with url: clear_tweets_path, method: :delete, class: "inline",
                          html: { onsubmit: "return confirm('Delete every tweet you have posted? This cannot be undone.')" } do %>
              <%= hidden_field_tag :panel, "privacy" %>
              <button class="btn btn-danger" type="submit">Delete all my tweets</button>
            <% end %>
          </div>

          <div class="settings-block">
            <h3 class="settings-block-title">Direct messages</h3>
            <p class="settings-block-note">
              Delete every direct message you have sent. Messages other people
              sent you are kept. This cannot be undone.
            </p>
            <%= form_with url: clear_messages_path, method: :delete, class: "inline",
                          html: { onsubmit: "return confirm('Delete every message you have sent? This cannot be undone.')" } do %>
              <%= hidden_field_tag :panel, "privacy" %>
              <button class="btn btn-danger" type="submit">Delete all my messages</button>
            <% end %>
          </div>

        <% when 'notifications' %>
          <h2 class="settings-panel-title">Notifications</h2>
          <p class="settings-panel-note">
            Notifications for this account are delivered on the
            <a href="<%= notifications_path %>">Notifications</a> page: replies,
            retweets, favorites, likes and new followers.
          </p>

        <% when 'preferences' %>
          <h2 class="settings-panel-title">Preferences</h2>
          <p class="settings-panel-note">
            Pick which era of the client you want to use. The choice is saved to
            your account, so it follows you to other browsers.
          </p>

          <div class="settings-block">
            <h3 class="settings-block-title">Design</h3>
            <p class="settings-block-note">
              The current client is the default. The other two are the earlier
              looks this site was built in.
            </p>
            <div class="settings-design-choices">
              <%# One submit button per design, all in a single form. Each
                  button carries the name of the design it stores, so the whole
                  set is one control and the chosen one is written by name. %>
              <%= form_with url: design_path, method: :patch, class: "settings-design-form" do %>
                <%= hidden_field_tag :panel, "preferences" %>
                <% User::DESIGNS.each do |option| %>
                  <% label, note = case option
                       when "2019" then ["2019", "The current client. Sidebar navigation and rounded cards."]
                       when "2015" then ["2015", "The classic client. Top navigation, no sidebar."]
                       else ["Prototype", "The very first design. Top navigation, narrower column."]
                     end %>
                  <button class="settings-design-choice <%= 'is-active' if current_user.design == option %>"
                          type="submit" name="design" value="<%= option %>">
                    <span class="settings-design-name"><%= label %></span>
                    <span class="settings-design-note"><%= note %></span>
                  </button>
                <% end %>
              <% end %>
            </div>
          </div>

        <% when 'accessibility' %>
          <h2 class="settings-panel-title">Accessibility, display, and languages</h2>
          <p class="settings-panel-note">
            Choose how the site looks. Your choice is saved to your account, so
            it follows you to other browsers.
          </p>

          <div class="settings-block">
            <h3 class="settings-block-title">Display</h3>
            <div class="settings-theme-choices">
              <%= form_with url: theme_path, method: :patch, class: "inline" do %>
                <%= hidden_field_tag :panel, "accessibility" %>
                <input type="hidden" name="theme" value="light">
                <button class="btn btn-theme <%= 'is-active' if !current_user.dark_theme? %>" type="submit">
                  <%= icon('sun') %> Light
                </button>
              <% end %>
              <%= form_with url: theme_path, method: :patch, class: "inline" do %>
                <%= hidden_field_tag :panel, "accessibility" %>
                <input type="hidden" name="theme" value="dark">
                <button class="btn btn-theme <%= 'is-active' if current_user.dark_theme? %>" type="submit">
                  <%= icon('moon') %> Dim
                </button>
              <% end %>
            </div>
          </div>

        <% when 'data' %>
          <h2 class="settings-panel-title">Your account data</h2>
          <p class="settings-panel-note">
            The accounts signed into this browser. Switching does not ask for a
            password again; removing one only forgets it here.
          </p>

          <div class="settings-block">
            <h3 class="settings-block-title">Accounts on this browser</h3>
            <ul class="account-switch-list">
              <% connected_accounts.each do |account| %>
                <li class="account-switch-row <%= 'is-current' if account.id == current_user.id %>">
                  <span class="account-switch-pic"><%= pic(account.avatar_path, 32) %></span>
                  <span class="account-switch-body">
                    <span class="account-switch-name"><%= account.display_name %></span>
                    <span class="account-switch-handle">@<%= account.username %></span>
                  </span>
                  <% if account.id == current_user.id %>
                    <span class="account-switch-current">Current</span>
                  <% else %>
                    <%= form_with url: switch_account_path(account.id), method: :post, class: "inline" do %>
                      <button class="btn btn-mini" type="submit">Switch</button>
                    <% end %>
                  <% end %>
                  <%= form_with url: forget_account_path(account.id), method: :delete, class: "inline" do %>
                    <button class="btn btn-mini" type="submit">Remove</button>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <p class="settings-block-note">
              Need to add another one? Use
              <strong>Add an existing account</strong> in the account menu at the
              bottom of the sidebar.
            </p>
          </div>

        <% else %>
          <h2 class="settings-panel-title">Account</h2>
          <p class="settings-panel-note">
            The details other people see on your profile.
          </p>

          <div class="settings-block">
            <%= form_with url: settings_path, method: :patch, class: "settings-form",
                          html: { multipart: true } do %>
              <%= hidden_field_tag :panel, "account" %>

              <div class="settings-avatar-row">
                <div class="settings-avatar">
                  <%= pic(current_user.avatar_path, 73) %>
                </div>
                <div class="settings-avatar-controls">
                  <label class="settings-file">
                    <span class="btn">Change profile photo</span>
                    <input type="file" name="avatar" accept="image/*">
                  </label>
                  <p class="settings-hint">JPG, GIF or PNG. Square images look best.</p>
                </div>
              </div>

              <div class="settings-field">
                <label for="settings-name">Name</label>
                <input id="settings-name" type="text" name="display_name" maxlength="50"
                       value="<%= current_user.display_name %>">
                <p class="settings-hint">Your name as it appears on your profile and in search.</p>
              </div>

              <div class="settings-field">
                <label for="settings-bio">Bio</label>
                <textarea id="settings-bio" name="bio" maxlength="160"><%= current_user.bio %></textarea>
                <p class="settings-hint">Tell people a little about yourself. 160 characters max.</p>
              </div>

              <div class="settings-field">
                <label for="settings-location">Location</label>
                <input id="settings-location" type="text" name="location" maxlength="60"
                       value="<%= current_user.location %>">
              </div>

              <div class="settings-field">
                <label for="settings-website">Website</label>
                <input id="settings-website" type="text" name="website" maxlength="200"
                       value="<%= current_user.website %>">
              </div>

              <div class="settings-field">
                <label for="settings-banner">Header</label>
                <label class="settings-file">
                  <span class="btn">Change header</span>
                  <input id="settings-banner" type="file" name="banner" accept="image/*">
                </label>
                <p class="settings-hint">Recommended 1500&times;500 for a header image.</p>
              </div>

              <button class="btn primary-btn" type="submit">Save changes</button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <aside class="col-right">
    <%= render "shared/rail" %>
  </aside>
</div>
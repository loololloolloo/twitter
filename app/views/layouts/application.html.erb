<!DOCTYPE html>
<%# The theme rides on the root element so the palette variables resolve before
    the first paint and the page never flashes light before turning dark. %>
<html lang="en" data-theme="<%= signed_in? && current_user.dark_theme? ? 'dark' : 'light' %>">
<head>
<meta charset="utf-8">
<title><%= content_for?(:title) ? yield(:title) : @site_name %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= stylesheet_link_tag "twitter" %>
<link rel="icon" href="<%= asset_path('icons/twitter-bird.svg') %>">
<%= csrf_meta_tags %>
</head>
<body class="<%= "logged-out" unless signed_in? %>">

<% if signed_in? %>
<%# The 2019 redesign moves navigation out of a global top bar and into a left
    sidebar: icon plus label, a primary action button, and the account switcher
    pinned to the bottom. The grid is three columns - the rail, the stream and
    the right rail - so the shell owns the horizontal structure rather than each
    page rebuilding it. %>
<div class="app-shell">
  <nav class="side-nav" aria-label="Primary">
    <a class="side-brand" href="<%= home_path %>" title="<%= @site_name %>"><%= bird %></a>

    <ul class="side-menu">
      <li>
        <a href="<%= home_path %>" class="side-link <%= 'is-active' if controller_name == 'timelines' && action_name == 'home' %>">
          <%= icon('house') %><span class="side-label">Home</span>
        </a>
      </li>
      <li>
        <a href="<%= explore_path %>" class="side-link <%= 'is-active' if controller_name == 'timelines' && action_name == 'explore' %>">
          <%= icon('magnifying-glass') %><span class="side-label">Explore</span>
        </a>
      </li>
      <li>
        <a href="<%= notifications_path %>" class="side-link <%= 'is-active' if controller_name == 'notifications' %>">
          <%= icon('bell') %><span class="side-label">Notifications</span>
        </a>
      </li>
      <li>
        <a href="<%= messages_path %>" class="side-link <%= 'is-active' if controller_name == 'messages' %>">
          <%= icon('chat') %><span class="side-label">Messages</span>
        </a>
      </li>
      <li>
        <a href="<%= profile_path(current_user.username) %>" class="side-link <%= 'is-active' if controller_name == 'profiles' && @user == current_user %>">
          <%= icon('user') %><span class="side-label">Profile</span>
        </a>
      </li>
      <li>
        <a href="<%= users_path %>" class="side-link <%= 'is-active' if controller_name == 'people' %>">
          <%= icon('user') %><span class="side-label">People</span>
        </a>
      </li>
      <% if can?('admin.access') %>
        <li>
          <a href="<%= admin_root_path %>" class="side-link"><%= icon('shield-halved') %><span class="side-label">Admin</span></a>
        </li>
      <% end %>
    </ul>

    <a class="side-compose" href="<%= home_path %>#reply"><%= icon('compose') %><span class="side-label">Tweet</span></a>

    <div class="side-account">
      <div class="account-menu">
        <a class="account-link" href="<%= profile_path(current_user.username) %>">
          <%= pic(current_user.avatar_path, 40) %>
          <span class="account-names">
            <span class="account-name"><%= current_user.display_name %></span>
            <span class="account-handle">@<%= current_user.username %></span>
          </span>
          <span class="account-caret"><%= icon('ellipsis') %></span>
        </a>
        <div class="account-dropdown">
          <a href="<%= profile_path(current_user.username) %>">View profile</a>
          <a href="<%= settings_path %>">Settings</a>
          <%# Shown for a single account too: the list is where a second account
              gets added, so hiding it until there are two could never be the
              way to get there. %>
          <a href="<%= accounts_path %>">Accounts</a>
          <% if can?('admin.access') %><a href="<%= admin_root_path %>">Admin</a><% end %>
          <a href="<%= logout_path %>">Sign out</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="app-main">
    <div class="page <%= 'page-wide' if controller_name == 'profiles' && action_name == 'show' %>">
<% else %>
  <div class="app-main app-main-public">
    <div class="page">
<% end %>

<% if @announcement.present? %>
  <div class="announcement-banner">
    <%= icon('bullhorn') %>
    <span><%= @announcement %></span>
  </div>
<% end %>

<div class="flash-wrap">
  <% flash.each do |key, message| %>
    <div class="flash <%= flash_class(key) %>"><%= message %></div>
  <% end %>
</div>

<%= yield %>

<% if signed_in? %>
    </div>
  </div>
</div>
<% else %>
    </div>
  </div>
<% end %>

<%# The rail already carries these links and the copyright on signed-in pages,
    so the global footer is only for the signed-out screens. %>
<% unless signed_in? %>
<footer class="site-footer">
  <a href="<%= about_path %>">About</a>
  <a href="<%= help_path %>">Help</a>
  <a href="<%= tos_path %>">Terms</a>
  <a href="<%= privacy_path %>">Privacy</a>
  <span>&copy; <%= @site_name %></span>
</footer>
<% end %>

<%= javascript_include_tag "jquery.min" %>
<%= javascript_include_tag "twitter" %>
</body>
</html>

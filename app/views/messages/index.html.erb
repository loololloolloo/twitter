<% content_for :title, "Messages / #{@site_name}" %>

<div class="layout">
  <aside class="col-left"></aside>

  <section class="col-main">
    <h2 class="section-title">Messages</h2>

    <ul class="conv-list">
      <% if @conversations.present? %>
        <% @conversations.each do |conversation| %>
          <% other = conversation.other_for(current_user) %>
          <% last = conversation.last_message %>
          <%# The whole row is the link, the way the 2015 DMInboxItem worked:
              clicking anywhere opens the thread, not just the name. %>
          <li class="conv">
            <a class="conv-link" href="<%= conversation_path(other.id) %>">
              <span class="conv-avatar"><%= pic(other.avatar_path, 48) %></span>
              <span class="conv-body">
                <span class="conv-name"><%= other.display_name.presence || other.username %></span>
                <span class="conv-handle">@<%= other.username %></span>
                <span class="conv-preview"><%= last&.body.presence || "No messages yet" %></span>
              </span>
            </a>
          </li>
        <% end %>
      <% else %>
        <li class="empty">No conversations. Visit someone's profile to send a message.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right"></aside>
</div>
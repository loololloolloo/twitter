<%# Trends, ranked by how many accounts are using each tag right now. Listed
    beside the timeline under "Who to follow" rather than in the right rail. %>
<% if @trends.present? %>
  <div class="panel">
    <h3 class="panel-title">Trends</h3>
    <ul class="trend-list">
      <% @trends.each do |tag, count, authors| %>
        <li>
          <a href="<%= explore_path(q: "##{tag}") %>">
            <span class="trend-tag">#<%= tag %></span>
            <span class="trend-count">
              <%= count %> <%= 'Tweet'.pluralize(count) %>
              &middot; <%= authors %> <%= 'account'.pluralize(authors) %>
            </span>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="panel">
  <h3 class="panel-title">About</h3>
  <p class="panel-note">A look at the classic Twitter web client.</p>
</div>
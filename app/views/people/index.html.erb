<% content_for :title, "Who to follow / #{@site_name}" %>

<div class="layout">
  <aside class="col-left"></aside>

  <section class="col-main">
    <h2 class="section-title">People on <%= @site_name %></h2>

    <ul class="people-list">
      <% if @people.present? %>
        <% @people.each do |person| %>
          <li class="person">
            <%= pic(person.avatar_path, 48) %>
            <div class="person-body">
              <a href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
              <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
              <span>@<%= person.username %></span>
              <p><%= count_label(person.follower_count) %> followers</p>
            </div>

            <% if current_user.following.exists?(id: person.id) %>
              <%= form_with url: follow_user_path(person.username), method: :delete, class: "inline" do %>
                <button class="btn btn-following" type="submit">Following</button>
              <% end %>
            <% else %>
              <%= form_with url: follow_user_path(person.username), method: :post, class: "inline" do %>
                <button class="btn btn-follow" type="submit">Follow</button>
              <% end %>
            <% end %>

            <a class="btn btn-follow" href="<%= conversation_path(person.id) %>">Message</a>
          </li>
        <% end %>
      <% else %>
        <li class="empty">Nobody else has signed up yet.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right"></aside>
</div>
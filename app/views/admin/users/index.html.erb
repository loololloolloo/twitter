<div class="page-head">
  <div>
    <h1>Accounts</h1>
    <p class="page-note">
      Every account on the site. Filter to the population you are working on;
      the row leads with the id so a username can be resolved to a record.
    </p>
  </div>
  <% if can?('lookup.run') %>
    <a class="btn" href="<%= admin_lookup_path %>">Look up an exact id</a>
  <% end %>
</div>

<form class="admin-filter" action="<%= admin_users_path %>" method="get">
  <input type="text" name="q" placeholder="Search username, name or email" value="<%= @search %>">
  <select name="role">
    <option value="">All roles</option>
    <% @roles.each do |role| %>
      <option value="<%= role.name %>" <%= 'selected' if @role_filter == role.name %>><%= role.name %></option>
    <% end %>
  </select>
  <select name="status">
    <option value="">Any status</option>
    <option value="banned" <%= 'selected' if @status == 'banned' %>>Banned</option>
    <option value="suspended" <%= 'selected' if @status == 'suspended' %>>Suspended</option>
    <option value="verified" <%= 'selected' if @status == 'verified' %>>Verified</option>
    <%# The three email states from the identity panel, so an operator can pull
        up every address that bounced, went inactive or sits on a private
        domain without visiting each account. %>
    <option value="bounced" <%= 'selected' if @status == 'bounced' %>>Bounced</option>
    <option value="inactive" <%= 'selected' if @status == 'inactive' %>>Inactive</option>
    <option value="protected" <%= 'selected' if @status == 'protected' %>>Protected</option>
  </select>
  <button class="btn btn-primary" type="submit">Filter</button>
</form>

<%= form_with url: admin_users_bulk_path, method: :post, class: "bulk-form", id: "bulk-form" do %>
<table class="data-table">
  <thead>
    <tr>
      <% if @bulk_actions.any? %>
        <th class="pick"><input type="checkbox" id="bulk-all" title="Select every account on this page"></th>
      <% end %>
      <th class="id">ID</th><th>Account</th><th>Role</th>
      <th class="num">Followers</th><th class="num">Posts</th>
      <th>Signals</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% if @users.present? %>
      <% @users.each do |user| %>
        <tr class="<%= 'row-suspended' if user.is_banned || user.is_suspended %>">
          <% if @bulk_actions.any? %>
            <td class="pick"><input type="checkbox" name="ids[]" value="<%= user.id %>" class="bulk-pick"></td>
          <% end %>
          <td class="id"><%= user.id %></td>
          <td>
            <strong><%= user.display_name %></strong>
            <% if user.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
            <br><span class="muted">@<%= user.username %> &middot; <%= user.email %></span>
          </td>
          <td><span class="pill pill-role"><%= user.role.name %></span></td>
          <td class="num"><%= count_label(user.follower_count) %></td>
          <td class="num"><%= user.tweet_count %></td>
          <td>
            <div class="tag-row">
              <% if user.is_banned %><span class="pill pill-warn">banned</span><% end %>
              <% if user.is_suspended %><span class="pill pill-warn">suspended</span><% end %>
              <% unless user.is_banned || user.is_suspended %><span class="pill">active</span><% end %>
              <% if user.requires_review %><span class="pill pill-bad" title="Consult before acting">escalation</span><% end %>
              <% if user.reach_limited? %><span class="pill pill-warn" title="Visibility limit in force">limited</span><% end %>
            </div>
          </td>
          <td><a class="btn btn-mini" href="<%= admin_user_path(user) %>">Manage</a></td>
        </tr>
      <% end %>
    <% else %>
      <tr><td colspan="<%= @bulk_actions.any? ? 8 : 7 %>" class="muted">No accounts matched.</td></tr>
    <% end %>
  </tbody>
</table>

<%# The bulk bar. It is part of the same form as the checkboxes, so a selection
    survives the action picker. Destructive actions cannot run from here: the
    selection is only read, and the confirmation screen that states the blast
    radius is where they are actually fired. %>
<% if @bulk_actions.any? %>
  <div class="bulk-bar">
    <span class="bulk-count" id="bulk-count">No accounts selected</span>
    <select name="action_key" id="bulk-action">
      <option value="">Choose an action&hellip;</option>
      <% @bulk_actions.each do |action| %>
        <option value="<%= action.key %>"><%= action.label %></option>
      <% end %>
    </select>
    <% if @bulk_actions.any? { |action| BulkUserAction.tag?(action.key) } %>
      <select name="tag" id="bulk-tag" class="bulk-tag">
        <option value="">Choose a tag&hellip;</option>
        <% User::ACCOUNT_TAGS.each do |key, label| %>
          <option value="<%= key %>"><%= label %></option>
        <% end %>
      </select>
    <% end %>
    <button class="btn btn-primary" type="submit">Review selection</button>
  </div>
  <p class="panel-note">
    Nothing changes here. The next screen names the exact accounts that will be
    affected and who is out of scope before anything is written.
  </p>
<% end %>
<% end %>

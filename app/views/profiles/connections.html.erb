<div class="layout">
  <section class="col-main">
    <nav class="stream-head">
      <a class="head-back" href="<%= profile_path(@user.username) %>" title="Back to profile">&#8592;</a>
      <div class="stream-head-title">
        <h1><%= @user.display_name %></h1>
        <span class="stream-head-sub"><%= count_label(@user.follower_count) %> followers</span>
      </div>
    </nav>

    <ul class="page-tabs">
      <li class="page-tab">
        <a href="<%= profile_path(@user.username) %>">Tweets</a>
      </li>
      <li class="page-tab <%= 'is-active' if @active == 'following' %>">
        <a href="<%= following_path(@user.username) %>">Following</a>
      </li>
      <li class="page-tab <%= 'is-active' if @active == 'followers' %>">
        <a href="<%= followers_path(@user.username) %>">Followers</a>
      </li>
    </ul>

    <% if @active == "followers" && @bonus_followers.to_i.positive? %>
      <div class="section-card">
        <p class="settings-note">
          Showing <%= @people.size %> of <%= count_label(@user.follower_count) %> followers.
          <% if @bonus_followers.to_i.positive? %>
            <%= @bonus_followers %> were granted by an administrator.
          <% end %>
        </p>
      </div>
    <% end %>

    <ul class="row-list">
      <% if @people.present? %>
        <% @people.each do |person| %>
          <li class="row-item">
            <a class="row-avatar" href="<%= profile_path(person.username) %>"><%= pic(person.avatar_path, 48) %></a>
            <div class="row-body">
              <div class="row-title">
                <a class="row-name" href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
                <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
                <span class="row-handle">@<%= person.username %></span>
              </div>
              <% if person.bio.present? %><p class="row-note"><%= person.bio %></p><% end %>
            </div>
            <% if person.id != current_user.id %>
              <div class="row-action">
                <% if current_user.following.exists?(id: person.id) %>
                  <%= form_with url: follow_user_path(person.username), method: :delete, class: "inline" do %>
                    <button class="btn btn-following btn-pill" type="submit">Following</button>
                  <% end %>
                <% else %>
                  <%= form_with url: follow_user_path(person.username), method: :post, class: "inline" do %>
                    <button class="btn btn-follow btn-pill" type="submit">Follow</button>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      <% else %>
        <li class="empty-note">
          <% if @active == "following" %>
            @<%= @user.username %> isn't following anyone yet.
          <% else %>
            @<%= @user.username %> doesn't have any followers yet.
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail" %>
  </aside>
</div>

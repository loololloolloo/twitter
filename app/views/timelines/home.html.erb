<% content_for :title, "Home / #{@site_name}" %>

<div class="layout">

  <aside class="col-left">
    <div class="panel profile-panel">
      <div class="panel-profile">
        <a class="panel-avatar" href="<%= profile_path(current_user.username) %>"><%= pic(current_user.avatar_path, 48) %></a>
        <a class="panel-name" href="<%= profile_path(current_user.username) %>"><%= current_user.display_name %></a>
        <span class="panel-handle">@<%= current_user.username %></span>
        <div class="panel-stats">
          <a href="<%= profile_path(current_user.username) %>">
            <strong><%= current_user.tweet_count %></strong><span>Tweets</span>
          </a>
          <a href="<%= following_path(current_user.username) %>">
            <strong><%= current_user.following_count %></strong><span>Following</span>
          </a>
          <a href="<%= followers_path(current_user.username) %>">
            <strong><%= count_label(current_user.follower_count) %></strong><span>Followers</span>
          </a>
        </div>
      </div>
    </div>

    <% if @suggestions.present? %>
      <div class="panel">
        <h3 class="panel-title">Who to follow</h3>
        <% @suggestions.each do |person| %>
          <div class="suggestion">
            <%= pic(person.avatar_path, 32) %>
            <div class="suggestion-body">
              <a href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
              <span>@<%= person.username %></span>
            </div>
            <%= form_with url: follow_user_path(person.username), method: :post, class: "inline" do %>
              <button class="btn btn-follow" type="submit">Follow</button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "timelines/sidebar" %>
  </aside>

  <section class="col-main">
    <%= render "tweets/composer" %>

    <div class="new-tweets" id="new-tweets" hidden>
      <a href="#" id="new-tweets-link">New tweets</a>
    </div>

    <ul class="timeline"
        id="timeline"
        data-feed-url="<%= home_feed_path %>"
        data-newest="<%= @tweets.map(&:created_at).max&.iso8601(6) %>">
      <% if @tweets.any? %>
        <% @tweets.each do |tweet| %>
          <%= render "tweets/tweet", tweet: tweet %>
        <% end %>
      <% else %>
        <li class="empty">No tweets yet. Follow someone or post the first one.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right"></aside>

</div>
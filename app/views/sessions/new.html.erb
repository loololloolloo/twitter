<% content_for :title, "Log in / #{@site_name}" %>

<%# The 2019 signed-out screen is one narrow column on the tinted page: the
    bird, a bold heading, then a rounded card holding the form. %>
<div class="auth-page">
  <div class="auth-bird"><%= bird %></div>
  <h1 class="auth-title">Log in to <%= @site_name %></h1>

  <div class="auth-card">
    <%= form_with url: login_path, method: :post, class: "auth-form", local: true do %>
      <%# The add flag has to survive the POST, not just the GET. Without it
          the submit looks like an ordinary sign-in and lands on the home
          feed instead of back on the account list it was opened from. %>
      <%= hidden_field_tag :add, "1" if params[:add].present? %>

      <div class="auth-field">
        <label for="signin-email">Phone, email or username</label>
        <input type="text" name="identifier" id="signin-email" autocomplete="on"
               placeholder="Phone, email or username"
               value="<%= params[:identifier] %>" autofocus>
      </div>

      <div class="auth-field">
        <label for="signin-password">Password</label>
        <input type="password" name="password" id="signin-password"
               placeholder="Password" autocomplete="current-password">
      </div>

      <button type="submit" class="auth-submit">Log in</button>

      <div class="auth-links">
        <label class="remember">
          <input type="checkbox" value="1" name="remember_me" checked="checked">
          Remember me
        </label>
        <a class="forgot" href="<%= login_path %>">Forgot password?</a>
      </div>
    <% end %>
  </div>

  <p class="auth-foot">
    New to <%= @site_name %>?
    <a id="login-signup-link" href="<%= signup_path %>">Sign up now</a>
  </p>
</div>
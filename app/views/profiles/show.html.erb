<%# The title has to follow the account's real state: only a permanently
    banned account is an "Account suspended" page. Every profile previously
    carried that title regardless of who it was. %>
<% content_for :title, "#{@user.permanently_banned? ? 'Account suspended' : "#{@user.display_name} (@#{@user.username})"} / #{@site_name}" %>

<% if @user.permanently_banned? %>
  <%# A permanently banned account keeps its handle visible so the page still
      resolves, but every personal detail is withheld - name, picture, bio,
      location, links and counts - and the picture falls back to the default. %>
  <div class="profile-canopy no-banner">
    <div class="statbar-avatar">
      <div class="statbar-avatar-frame"><%= pic(nil, 200) %></div>
    </div>
  </div>

  <div class="profile-statbar">
    <div class="statbar-inner">
      <ul class="statbar-metrics"></ul>
      <div class="statbar-actions"></div>
    </div>
  </div>

  <div class="profile-body">
    <aside class="profile-side">
      <h1 class="profile-name"><span class="muted">Account suspended</span></h1>
      <h2 class="profile-screenname">@<%= @user.username %></h2>
      <p class="profile-banned-label"><%= icon('ban') %> Account permanently banned</p>
      <p class="profile-banned-note muted">
        This account has been permanently banned and its information is no longer available.
      </p>
    </aside>
  </div>
<% else %>
<%# Two columns, like the rest of the shell: the account's stream - banner,
    stat bar, tabs and timeline as one card - beside the suggestion rail. The
    picture is a child of the banner so it cannot drift into the metrics when
    the layout narrows. %>
<div class="layout">
  <section class="col-main">
  <div class="profile-canopy <%= @user.banner_path.present? ? 'has-banner' : 'no-banner' %>"
       <% if @user.banner_path.present? %>style="background-image:url('/uploads/<%= @user.banner_path %>')"<% end %>>
    <div class="statbar-avatar">
      <div class="statbar-avatar-frame"><%= pic(@user.avatar_path, 200) %></div>
    </div>
  </div>

<div class="profile-statbar">
  <div class="statbar-inner">
    <ul class="statbar-metrics">
      <li class="sm-item <%= 'is-active' if @active == 'tweets' %>">
        <a href="<%= profile_path(@user.username) %>">
          <span class="sm-label">Tweets</span>
          <span class="sm-value"><%= @tweet_count %></span>
        </a>
      </li>
      <li class="sm-item <%= 'is-active' if @active == 'following' %>">
        <a href="<%= following_path(@user.username) %>">
          <span class="sm-label">Following</span>
          <span class="sm-value"><%= @following_count %></span>
        </a>
      </li>
      <li class="sm-item <%= 'is-active' if @active == 'followers' %>">
        <a href="<%= followers_path(@user.username) %>">
          <span class="sm-label">Followers</span>
          <span class="sm-value"><%= count_label(@follower_count) %></span>
        </a>
      </li>
      <li class="sm-item <%= 'is-active' if @active == 'favorites' %>">
        <a href="<%= profile_path(@user.username, tab: 'favorites') %>">
          <span class="sm-label">Favorites</span>
          <span class="sm-value"><%= @favorites_count %></span>
        </a>
      </li>
    </ul>

    <div class="statbar-actions">
      <% if @is_me %>
        <a class="btn btn-edit" href="<%= settings_path %>">Edit profile</a>
      <% else %>
        <a class="btn btn-msg" href="<%= conversation_path(@user.id) %>" title="Message">Message</a>
        <% if @is_following %>
          <%= form_with url: follow_user_path(@user.username), method: :delete, class: "inline" do %>
            <button class="btn btn-following" type="submit">Following</button>
          <% end %>
        <% else %>
          <%= form_with url: follow_user_path(@user.username), method: :post, class: "inline" do %>
            <button class="btn btn-follow" type="submit">Follow</button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="profile-body">
  <aside class="profile-side">
    <h1 class="profile-name">
      <%= @user.display_name %>
      <% if @user.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
    </h1>
    <h2 class="profile-screenname">@<%= @user.username %></h2>
    <% if @user.bio.present? %><p class="profile-bio"><%= linkify(@user.bio) %></p><% end %>
    <div class="profile-fields">
      <% if @user.location.present? %>
        <span><%= icon('location-dot') %> <%= @user.location %></span>
      <% end %>
      <% if @user.website.present? %>
        <span><%= icon('link') %> <a href="<%= @user.website %>" target="_blank" rel="me nofollow noopener"><%= display_url(@user.website) %></a></span>
      <% end %>
      <span><%= icon('clock') %> Joined <%= joined(@user.created_at) %></span>
    </div>

    <% if @photo_strip.present? %>
      <div class="photo-strip">
        <div class="photo-strip-title"><%= icon('image') %> <span>Photos and videos</span></div>
        <div class="photo-strip-grid">
          <% @photo_strip.each do |tweet| %>
            <a class="photo-strip-cell" href="<%= profile_path(@user.username, tab: 'media') %>">
              <img src="/uploads/<%= tweet.media_path %>" alt="">
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  </aside>

  <section class="profile-stream">
    <ul class="stream-tabs">
      <li class="st-item <%= 'is-active' if @active == 'tweets' %>">
        <a href="<%= profile_path(@user.username) %>">Tweets</a>
      </li>
      <li class="st-item <%= 'is-active' if @active == 'favorites' %>">
        <a href="<%= profile_path(@user.username, tab: 'favorites') %>">Tweets &amp; replies</a>
      </li>
      <li class="st-item <%= 'is-active' if @active == 'media' %>">
        <a href="<%= profile_path(@user.username, tab: 'media') %>">Media</a>
      </li>
    </ul>

    <% if @active == "media" %>
      <% if @media.present? %>
        <div class="media-rail">
          <% @media.each do |tweet| %>
            <a class="media-cell" href="<%= tweet_path(tweet) %>">
              <img src="/uploads/<%= tweet.media_path %>" alt="">
            </a>
          <% end %>
        </div>
      <% else %>
        <p class="empty">No photos or videos yet.</p>
      <% end %>
    <% else %>
      <ul class="timeline">
        <% if @tweets.present? %>
          <% @tweets.each do |tweet| %>
            <%= render "tweets/tweet", tweet: tweet %>
          <% end %>
        <% else %>
          <li class="empty">
            <% if @active == "favorites" %>No favorites yet.
            <% elsif @is_me %>You haven't tweeted yet.
            <% else %>No tweets yet.<% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

</div>
  </section>

  <aside class="col-right profile-aside">
    <%= render "shared/rail", suggestions: @suggestions, trends_title: "Trends for you" %>
  </aside>
</div>
<% end %>
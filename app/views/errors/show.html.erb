<% content_for :title, "#{@code} / #{@site_name}" %>

<div id="page-outer">
  <div id="page-container" class="wrapper wrapper-login">
    <div class="page-canvas">
      <div class="signin-wrapper">
        <h1><%= @code %></h1>
        <p class="signup-helper"><%= @message %></p>
        <a class="btn primary-btn" href="<%= @back_path %>">Go home</a>
      </div>
    </div>
  </div>
</div>
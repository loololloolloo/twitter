<%# The aside every page renders. Which rail it becomes is the account's design:
    the 2019 client puts search, trends and suggestions in rounded cards down the
    right, while the recovered designs put the account card, suggestions and
    trends in a flat panel column on the left. Pages call this one partial so a
    page never has to know which design is active.
    Locals are forwarded only when the caller set them, so the target partial's
    own defaults still apply. %>
<% opts = {} %>
<% opts[:suggestions] = local_assigns[:suggestions] if local_assigns.key?(:suggestions) %>
<% opts[:trends_title] = local_assigns[:trends_title] if local_assigns.key?(:trends_title) %>
<% if signed_in? && current_user.legacy_design? %>
  <%= render "shared/legacy_rail", **opts %>
<% else %>
  <%= render "shared/modern_rail", **opts %>
<% end %>

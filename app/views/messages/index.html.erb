<%# The 2019 inbox is two panes: the conversation list on the left and the open
    thread on the right. With nothing selected the right pane says so rather
    than redirecting, so the list is never lost. %>
<div class="page page-dm">
  <div class="dm-shell">
    <div class="dm-list-pane">
      <div class="dm-list-head">
        <div class="dm-list-title-row">
          <h1 class="dm-list-title">Messages</h1>
          <%# 2019 put a compose control at the top of the inbox so a
              conversation could be started without visiting a profile. It is a
              <details> disclosure rather than a modal so the picker still opens
              with the script unavailable, and it is already open when the
              account is mid-pick, which is how an unresolved handle keeps its
              place while it is corrected. %>
          <details class="dm-compose" <%= "open" if @recipient_query.present? %>>
            <summary class="dm-compose-open" aria-label="New message" title="New message"><%= icon('compose') %></summary>
            <div class="dm-compose-panel">
              <%= form_with url: compose_message_path, method: :post, class: "dm-compose-picker" do %>
                <input type="text" name="to" list="dm-recipients"
                       placeholder="Search for a username"
                       value="<%= @recipient_query %>"
                       autocomplete="off"
                       aria-label="Search for an account to message">
                <button class="auth-submit" type="submit">Next</button>
              <% end %>

              <%# The picker resolves a handle, so its outcome is stated before
                  anything is sent: which account matched, or that nothing did. %>
              <% if @recipient_query.present? && @recipient.nil? %>
                <p class="dm-compose-note">No account is using that username.</p>
              <% elsif @recipient == current_user %>
                <p class="dm-compose-note">You cannot send a message to yourself.</p>
              <% elsif @recipient.present? %>
                <div class="dm-compose-picked">
                  <a href="<%= profile_path(@recipient.username) %>"><%= pic(@recipient.avatar_path, 48) %></a>
                  <span class="dm-list-body">
                    <span class="dm-list-names">
                      <span class="dm-list-name"><%= @recipient.display_name.presence || @recipient.username %></span>
                      <span class="dm-list-handle">@<%= @recipient.username %></span>
                    </span>
                  </span>
                </div>
                <%= form_with url: conversation_path(@recipient), method: :post, class: "dm-compose-new-inline" do %>
                  <textarea name="body" placeholder="Start a new message" required></textarea>
                  <button class="auth-submit" type="submit">Send</button>
                <% end %>
              <% end %>
            </div>
          </details>
        </div>

        <%# The picker is a handle field, not a free-text search, so the accounts
            offered are exactly the registered handles. %>
        <datalist id="dm-recipients">
          <% @recipients.each do |person| %>
            <option value="@<%= person.username %>">
              <%= person.display_name.presence || person.username %>
            </option>
          <% end %>
        </datalist>
      </div>

      <ul class="dm-list">
        <% if @conversations.present? %>
          <% @conversations.each do |conversation| %>
            <% other = conversation.other_for(current_user) %>
            <% last = conversation.last_message %>
            <li class="dm-list-item">
              <a class="dm-list-link" href="<%= conversation_path(other.id) %>">
                <span class="row-avatar"><%= pic(other.avatar_path, 48) %></span>
                <span class="dm-list-body">
                  <span class="dm-list-names">
                    <span class="dm-list-name"><%= other.display_name.presence || other.username %></span>
                    <span class="dm-list-handle">@<%= other.username %></span>
                  </span>
                  <%# 2019 dated the row on the preview line, so the list could
                      be scanned for what arrived lately, not just for who. Only
                      a conversation that has a message carries a date; a thread
                      with nothing in it has no arrival to name. %>
                  <span class="dm-list-preview">
                    <span class="dm-list-preview-text"><%= last&.body.presence || "No messages yet" %></span>
                    <% if last %><span class="dm-list-time"><%= time_ago(last.created_at) %></span><% end %>
                  </span>
                </span>
              </a>
            </li>
          <% end %>
        <% else %>
          <%# 2019 emptied the inbox into the same centred shape as the rest
              of the client - a glyph over a heading and a line naming what
              fills it - not a bare note in a row that reads as a row that
              failed to render. %>
          <li class="dm-empty-state">
            <span class="dm-empty-icon" aria-hidden="true"><%= icon('envelope') %></span>
            <h2>You don't have any messages yet</h2>
            <p>When you start a conversation, it will show up here.</p>
          </li>
        <% end %>
      </ul>
    </div>

    <%# With nothing selected the right pane is the 2019 placeholder: a large
        centred envelope over the "Select a message" prompt and a one-line
        explanation, rather than a bare heading over a paragraph. %>
    <div class="dm-thread-pane">
      <div class="dm-empty-state">
        <span class="dm-empty-icon" aria-hidden="true"><%= icon('envelope') %></span>
        <h2>Select a message</h2>
        <p>Choose from your existing conversations, or start a new one from a
          profile's Message button.</p>
      </div>
    </div>
  </div>
</div>
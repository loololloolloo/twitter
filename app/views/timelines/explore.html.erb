<div class="layout">
  <section class="col-main">
    <div class="stream-head">
      <div class="stream-head-title">
        <h1><% if @query.present? %>Results for &ldquo;<%= @query %>&rdquo;<% else %>Explore<% end %></h1>
      </div>
    </div>

    <%# The 2019 search screen split its results across tabs. They are views of
        the same query rather than separate pages, so each one is a link back to
        this screen with a different `tab`. The tabs only appear once there is a
        query, since there is nothing to narrow before that. %>
    <% if @query.present? %>
      <ul class="profile-tabs">
        <% { "top" => "Top", "latest" => "Latest", "people" => "People", "photos" => "Photos" }.each do |key, label| %>
          <li class="pt-item <%= 'is-active' if @tab == key %>">
            <% if @tab == key %>
              <span><%= label %></span>
            <% else %>
              <a href="<%= explore_path(q: @query, tab: key) %>"><%= label %></a>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @query.present? && @people.present? && %w[top people].include?(@tab) %>
      <div class="section-card">
        <h2>People</h2>
        <ul class="row-list">
          <% @people.each do |person| %>
            <li class="row-item">
              <a class="row-avatar" href="<%= profile_path(person.username) %>"><%= pic(person.avatar_path, 48) %></a>
              <div class="row-body">
                <div class="row-title">
                  <a class="row-name" href="<%= profile_path(person.username) %>"><%= person.display_name %></a>
                  <% if person.is_verified %><span class="verified-badge" title="Verified account"><%= icon('verified') %></span><% end %>
                  <span class="row-handle">@<%= person.username %></span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <ul class="timeline">
      <% if @tweets.present? %>
        <% @tweets.each do |tweet| %>
          <%= render "tweets/tweet", tweet: tweet %>
        <% end %>
      <% else %>
        <li class="empty-note">Nothing found.</li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail", trends_title: "Trending" %>
  </aside>
</div>
<div class="banned-page">
  <div class="banned-box">
    <img class="banned-bird" src="<%= asset_path('icons/twitter-bird.svg') %>" alt="">
    <h1>Your account is suspended</h1>
    <p class="banned-lead">
      Your account has been suspended. You can't use <%= @site_name %> until the suspension is lifted.
    </p>

    <dl class="banned-details">
      <dt>Reason</dt>
      <dd><%= @ban.ban_reason.presence || 'No reason was given.' %></dd>

      <dt>Duration</dt>
      <dd>
        <% if @ban.ban_permanent? %>
          Permanent
        <% elsif @until.present? %>
          <%= @until %> (<%= @ban.ban_expires_at.strftime('%Y-%m-%d %H:%M:%S') %>)
        <% else %>
          Temporary
        <% end %>
      </dd>

      <dt>Account</dt>
      <dd>@<%= @ban.username %></dd>
    </dl>

    <% unless @ban.ban_permanent? %>
      <p class="banned-note">Access is restored automatically when the suspension ends.</p>
    <% end %>

    <%# Contesting the ban is the member's only move while the gate is closed.
        The form carries no account id, so it can only ever file against the
        signed-in account. %>
    <div class="banned-appeal">
      <% pending_appeal = @ban.appeals.pending.order(created_at: :desc).first %>
      <% if pending_appeal %>
        <p class="banned-note">
          Your appeal was sent <%= time_ago(pending_appeal.created_at) %> and is waiting for review.
        </p>
      <% else %>
        <h2 class="banned-appeal-title">Appeal this decision</h2>
        <p class="banned-note">
          If you think this was a mistake, tell us why. An operator who did not
          make the original decision will review it.
        </p>
        <%= form_with url: appeals_path, method: :post, class: "banned-appeal-form" do %>
          <label for="appeal-body">Why should this be reviewed?</label>
          <textarea id="appeal-body" name="body" rows="4" maxlength="4000"
                    placeholder="Give us the context we should consider."></textarea>
          <button class="btn btn-primary" type="submit">Submit appeal</button>
        <% end %>
      <% end %>
    </div>

    <a class="btn btn-primary banned-logout" href="<%= logout_path %>">Log out</a>
  </div>
</div>
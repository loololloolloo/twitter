<div class="layout">
  <section class="col-main">
    <div class="stream-head">
      <div class="stream-head-title">
        <h1>Bookmarks</h1>
        <span class="stream-sub">@<%= current_user.username %></span>
      </div>
      <% if @tweets.present? %>
        <%= button_to "Clear all", clear_bookmarks_path, method: :delete,
                      class: "btn btn-quiet",
                      form: { onsubmit: "return confirm('Remove every saved post?')" } %>
      <% end %>
    </div>

    <p class="stream-note">Only you can see your saved posts.</p>

    <ul class="tweet-list">
      <% if @tweets.present? %>
        <%= render partial: "tweets/tweet", collection: @tweets, as: :tweet %>
      <% else %>
        <li>
          <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true"><%= icon('bookmark-regular') %></span>
            <h2>You haven&rsquo;t added any Tweets to your Bookmarks yet</h2>
            <p>Tap the share icon on a Tweet and choose Bookmark to keep it here
              so you can find it again later.</p>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <aside class="col-right">
    <%= render "shared/rail" %>
  </aside>
</div>